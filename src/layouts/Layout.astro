---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AION — Explore Humanity Through Time",
  description = "Explore the history, mythology, civilizations, people, places and stories of humanity through time.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#080a0d" />

    <link
      rel="icon"
      type="image/x-icon"
      href="/logo.ico"
    />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>