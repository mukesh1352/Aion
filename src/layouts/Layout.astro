---
import "../styles/global.css";
import "../styles/transition.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Explore humanity through time.",
} = Astro.props;
---

<!doctype html>

<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <link
      rel="icon"
      type="image/x-icon"
      href="/logo.ico"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

  </head>

  <body>

    <slot />

  </body>

</html>