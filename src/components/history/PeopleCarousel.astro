---
import type { CollectionEntry } from "astro:content";

interface Props {
  people: CollectionEntry<"historicalContent">[];
}

const { people } = Astro.props;
---

<section
  class="people-section"
  data-carousel-section
>
  <!-- ==================================================
       PEOPLE HEADER
       ================================================== -->

  <div class="section-header">
    <div>
      <span class="section-kicker">
        PEOPLE
      </span>

      <h3>
        People of the era
      </h3>
    </div>

    <div class="carousel-controls">
      <button
        type="button"
        class="carousel-button"
        data-carousel-prev
        aria-label="Previous person"
      >
        ←
      </button>

      <button
        type="button"
        class="carousel-button"
        data-carousel-next
        aria-label="Next person"
      >
        →
      </button>
    </div>
  </div>

  <!-- ==================================================
       CAROUSEL
       ================================================== -->

  <div
    class="people-carousel"
    data-people-carousel
  >
    <div
      class="people-stage"
      data-people-stage
    >
      {
        people.map(
          (person, index) => (
            <article
              class="person-card"
              data-person-card
              data-index={index}
            >
              <!-- ==========================================
                   PERSON VISUAL
                   ========================================== -->

              <div class="person-card-visual">
                {
                  person.data.image ? (
                    <img
                      src={person.data.image}
                      alt={
                        person.data.imageAlt ??
                        person.data.title
                      }
                      class="person-card-image"
                      loading="lazy"
                      draggable="false"
                    />
                  ) : (
                    <div class="person-card-image-placeholder">
                      <span>AION</span>
                    </div>
                  )
                }

                <div class="person-card-image-overlay"></div>

                <div class="person-card-glow"></div>

                <div class="person-card-era">
                  {person.data.era
                    .replaceAll("-", " ")
                    .toUpperCase()}
                </div>

                <div class="person-card-center">
                  <span class="person-card-type">
                    PERSON
                  </span>

                  <h4>
                    {person.data.title}
                  </h4>

                  {
                    person.data.subtitle && (
                      <p>
                        {person.data.subtitle}
                      </p>
                    )
                  }
                </div>

                <div class="person-card-line"></div>
              </div>

              <!-- ==========================================
                   PERSON INFORMATION
                   ========================================== -->

              <div class="person-card-body">
                <p class="person-card-category">
                  {person.data.category ??
                    "Historical Figure"}
                </p>

                <p class="person-description">
                  {person.data.summary}
                </p>

                <!--
                  Keep the metadata complete in MDX,
                  but only show a small selection
                  in the carousel.
                -->
                {
                  person.data.tags &&
                  person.data.tags.length > 0 && (
                    <div class="content-tags">
                      {
                        person.data.tags
                          .slice(0, 5)
                          .map((tag) => (
                            <span class="content-tag">
                              {tag}
                            </span>
                          ))
                      }
                    </div>
                  )
                }

                <div class="person-card-footer">
                  <span class="content-status">
                    {person.data.status
                      .replaceAll(
                        "-",
                        " "
                      )
                      .toUpperCase()}
                  </span>

                  <a
                    href={`/india/${person.id}`}
                    class="learn-more"
                  >
                    <span>
                      Explore person
                    </span>

                    <span class="learn-arrow">
                      →
                    </span>
                  </a>
                </div>
              </div>
            </article>
          )
        )
      }
    </div>
  </div>

  <!-- ==================================================
       PROGRESS
       ================================================== -->

  <div class="carousel-progress-row">
    <span
      class="carousel-index"
      data-carousel-index
    >
      01
    </span>

    <div class="carousel-progress">
      <div
        class="carousel-progress-track"
        data-carousel-progress
      ></div>
    </div>

    <span class="carousel-total">
      {String(people.length).padStart(2, "0")}
    </span>
  </div>
</section>

<script>
  import { animate } from "animejs";

  class PeopleCarousel {
    private section: HTMLElement;

    private cards: HTMLElement[];

    private stage: HTMLElement;

    private previous: HTMLButtonElement;

    private next: HTMLButtonElement;

    private progress: HTMLElement;

    private currentIndex: HTMLElement;

    private activeIndex = 0;

    private startX = 0;

    private currentDelta = 0;

    private dragging = false;

    constructor(section: HTMLElement) {
      this.section = section;

      this.cards = Array.from(
        section.querySelectorAll<HTMLElement>(
          "[data-person-card]"
        )
      );

      this.stage =
        section.querySelector<HTMLElement>(
          "[data-people-stage]"
        )!;

      this.previous =
        section.querySelector<HTMLButtonElement>(
          "[data-carousel-prev]"
        )!;

      this.next =
        section.querySelector<HTMLButtonElement>(
          "[data-carousel-next]"
        )!;

      this.progress =
        section.querySelector<HTMLElement>(
          "[data-carousel-progress]"
        )!;

      this.currentIndex =
        section.querySelector<HTMLElement>(
          "[data-carousel-index]"
        )!;

      if (
        !this.cards.length ||
        !this.stage ||
        !this.previous ||
        !this.next ||
        !this.progress ||
        !this.currentIndex
      ) {
        return;
      }

      /* ----------------------------------------------
         BUTTONS
         ---------------------------------------------- */

      this.previous.addEventListener(
        "click",
        () => {
          this.goTo(
            this.activeIndex - 1
          );
        }
      );

      this.next.addEventListener(
        "click",
        () => {
          this.goTo(
            this.activeIndex + 1
          );
        }
      );

      /* ----------------------------------------------
         POINTER / DRAG
         ---------------------------------------------- */

      this.stage.addEventListener(
        "pointerdown",
        this.handlePointerDown
      );

      this.stage.addEventListener(
        "pointermove",
        this.handlePointerMove
      );

      this.stage.addEventListener(
        "pointerup",
        this.handlePointerUp
      );

      this.stage.addEventListener(
        "pointercancel",
        this.handlePointerUp
      );

      /* ----------------------------------------------
         KEYBOARD
         ---------------------------------------------- */

      window.addEventListener(
        "keydown",
        this.handleKeyboard
      );

      this.stage.style.cursor = "grab";

      /*
       * Expose refresh method to the parent
       * IndiaContentController.
       */
      (
        section as HTMLElement & {
          __aionPeopleCarousel?: {
            refresh: () => void;
          };
        }
      ).__aionPeopleCarousel = {
        refresh: () => this.refresh(),
      };

      this.update(false);
    }

    /* ==================================================
       PUBLIC REFRESH
       ================================================== */

    public refresh() {
      if (!this.cards.length) {
        return;
      }

      this.update(false);
    }

    /* ==================================================
       POSITION
       ================================================== */

    private getOffset(
      index: number
    ): number {
      const total =
        this.cards.length;

      let offset =
        index - this.activeIndex;

      if (offset > total / 2) {
        offset -= total;
      }

      if (offset < -total / 2) {
        offset += total;
      }

      return offset;
    }

    private getSpacing(): number {
      const width =
        this.stage.clientWidth;

      /*
       * If the carousel was hidden during
       * initialization, width can be 0.
       *
       * Returning a sensible minimum prevents
       * the cards from collapsing into the same
       * position.
       */
      if (width <= 0) {
        return 360;
      }

      return Math.min(
        width * 0.34,
        430
      );
    }

    private update(
      animateCards = true
    ) {
      this.cards.forEach(
        (card, index) => {
          const offset =
            this.getOffset(index);

          this.applyCardPosition(
            card,
            offset,
            0,
            animateCards
          );
        }
      );

      this.updateControls();
    }

    private applyCardPosition(
      card: HTMLElement,
      offset: number,
      dragDelta: number,
      shouldAnimate: boolean
    ) {
      const spacing =
        this.getSpacing();

      const abs =
        Math.abs(offset);

      const x =
        offset * spacing +
        dragDelta * 0.45;

      const z =
        -abs * 120;

      const rotateY =
        offset === 0
          ? dragDelta * -0.02
          : offset > 0
            ? -18 -
              Math.min(
                abs * 5,
                22
              )
            : 18 +
              Math.min(
                abs * 5,
                22
              );

      const scale =
        offset === 0
          ? 1
          : Math.max(
              0.72,
              0.94 -
                abs * 0.1
            );

      const opacity =
        offset === 0
          ? 1
          : Math.max(
              0.28,
              0.82 -
                abs * 0.2
            );

      animate(card, {
        translateX: x,
        translateY: "-50%",
        translateZ: z,
        rotateY,
        scale,
        opacity,
        duration:
          shouldAnimate ? 700 : 0,
        ease: "out(4)",
      });

      card.style.zIndex =
        String(
          100 -
            Math.round(
              abs * 10
            )
        );

      card.style.pointerEvents =
        offset === 0
          ? "auto"
          : "none";

      card.setAttribute(
        "aria-hidden",
        offset === 0
          ? "false"
          : "true"
      );
    }

    /* ==================================================
       CONTROLS
       ================================================== */

    private updateControls() {
      const total =
        this.cards.length;

      this.previous.disabled =
        total <= 1;

      this.next.disabled =
        total <= 1;

      const progress =
        total <= 1
          ? 100
          : (
              (this.activeIndex + 1) /
              total
            ) * 100;

      this.progress.style.width =
        `${progress}%`;

      this.currentIndex.textContent =
        String(
          this.activeIndex + 1
        ).padStart(2, "0");
    }

    /* ==================================================
       NAVIGATION
       ================================================== */

    private goTo(index: number) {
      if (
        this.cards.length <= 1
      ) {
        return;
      }

      this.activeIndex =
        (
          index +
          this.cards.length
        ) %
        this.cards.length;

      this.currentDelta = 0;

      this.update(true);
    }

    /* ==================================================
       POINTER DOWN
       ================================================== */

    private handlePointerDown = (
      event: PointerEvent
    ) => {
      if (
        event.target instanceof
          HTMLElement &&
        event.target.closest(
          "a, button"
        )
      ) {
        return;
      }

      this.dragging = true;

      this.startX =
        event.clientX;

      this.currentDelta = 0;

      this.stage.setPointerCapture(
        event.pointerId
      );

      this.stage.style.cursor =
        "grabbing";
    };

    /* ==================================================
       POINTER MOVE
       ================================================== */

    private handlePointerMove = (
      event: PointerEvent
    ) => {
      if (!this.dragging) {
        return;
      }

      this.currentDelta =
        event.clientX -
        this.startX;

      const delta =
        this.currentDelta;

      this.cards.forEach(
        (card, index) => {
          const offset =
            this.getOffset(index);

          this.applyCardPosition(
            card,
            offset,
            delta,
            false
          );
        }
      );
    };

    /* ==================================================
       POINTER UP
       ================================================== */

    private handlePointerUp = (
      event: PointerEvent
    ) => {
      if (!this.dragging) {
        return;
      }

      this.dragging = false;

      if (
        this.stage.hasPointerCapture(
          event.pointerId
        )
      ) {
        this.stage.releasePointerCapture(
          event.pointerId
        );
      }

      this.stage.style.cursor =
        "grab";

      const delta =
        this.currentDelta;

      this.currentDelta = 0;

      if (
        Math.abs(delta) > 70
      ) {
        if (delta < 0) {
          this.goTo(
            this.activeIndex + 1
          );
        } else {
          this.goTo(
            this.activeIndex - 1
          );
        }

        return;
      }

      this.update(true);
    };

    /* ==================================================
       KEYBOARD
       ================================================== */

    private handleKeyboard = (
      event: KeyboardEvent
    ) => {
      if (
        event.key !== "ArrowLeft" &&
        event.key !== "ArrowRight"
      ) {
        return;
      }

      const target =
        event.target as
          | HTMLElement
          | null;

      if (
        target?.matches(
          "input, textarea, select"
        )
      ) {
        return;
      }

      /*
       * Only react when this carousel
       * is actually visible.
       */
      const rect =
        this.section.getBoundingClientRect();

      const visible =
        rect.bottom > 0 &&
        rect.top <
          window.innerHeight &&
        rect.width > 0 &&
        rect.height > 0;

      if (!visible) {
        return;
      }

      event.preventDefault();

      if (
        event.key ===
        "ArrowLeft"
      ) {
        this.goTo(
          this.activeIndex - 1
        );
      }

      if (
        event.key ===
        "ArrowRight"
      ) {
        this.goTo(
          this.activeIndex + 1
        );
      }
    };
  }

  /* ==========================================================
     INITIALIZE
     ========================================================== */

  const sections =
    document.querySelectorAll<HTMLElement>(
      "[data-carousel-section]"
    );

  sections.forEach(
    (section) => {
      new PeopleCarousel(section);
    }
  );
</script>