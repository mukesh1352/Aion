<script>
  import { animate as animeAnimate } from "animejs";
  import gsap from "gsap";
  import * as THREE from "three";

  /* =====================================================
     TYPES
     ===================================================== */

  type EraVibe =
    | "firelight"
    | "desertHeat"
    | "marbleHall"
    | "candlelight"
    | "painterly"
    | "oldFilm"
    | "archive";

  const ERA_KEYWORD_VIBES: [RegExp, EraVibe][] = [
    [/paleo|stone.?age|prehistor|ice.?age|neolithic/i, "firelight"],
    [/egypt|bronze.?age|mesopotam|sumer|babylon|pharaoh/i, "desertHeat"],
    [/gree|rome|roman|classical|antiquit|hellenis/i, "marbleHall"],
    [/medieval|middle.?ages|feudal|byzant|crusad/i, "candlelight"],
    [/renaissance|baroque/i, "painterly"],
    [/industrial|victorian|colonial|19th/i, "oldFilm"],
    [/modern|contemporary|20th|21st/i, "archive"],
  ];

  const MATERIAL_VIBE_FALLBACK: Record<string, EraVibe> = {
    stone: "marbleHall",
    clay: "desertHeat",
    parchment: "candlelight",
    scroll: "candlelight",
    paper: "painterly",
    archival: "archive",
  };

  function resolveEraVibe(eraId: string, material: string): EraVibe {
    for (const [pattern, vibe] of ERA_KEYWORD_VIBES) {
      if (pattern.test(eraId)) return vibe;
    }
    return MATERIAL_VIBE_FALLBACK[material] ?? "archive";
  }

  /* =====================================================
     PARTICLE CONFIG PER VIBE

     "drift" selects the per-frame motion behavior used
     in the render loop below.
     ===================================================== */

  type DriftMode = "rise" | "horizontal" | "float" | "static";

  interface ParticleConfig {
    count: number;
    color: number;
    size: number;
    speed: number;
    opacity: number;
    blending: THREE.Blending;
    drift: DriftMode;
  }

  const PARTICLE_CONFIGS: Record<EraVibe, ParticleConfig> = {
    firelight: {
      count: 140,
      color: 0xffab5c,
      size: 5,
      speed: 0.09,
      opacity: 0.75,
      blending: THREE.AdditiveBlending,
      drift: "rise",
    },
    desertHeat: {
      count: 90,
      color: 0xdcb87e,
      size: 3,
      speed: 0.035,
      opacity: 0.4,
      blending: THREE.NormalBlending,
      drift: "horizontal",
    },
    marbleHall: {
      count: 70,
      color: 0xe9e4d4,
      size: 2.4,
      speed: 0.012,
      opacity: 0.32,
      blending: THREE.NormalBlending,
      drift: "float",
    },
    candlelight: {
      count: 110,
      color: 0xf0d79c,
      size: 2.8,
      speed: 0.02,
      opacity: 0.5,
      blending: THREE.NormalBlending,
      drift: "float",
    },
    painterly: {
      count: 36,
      color: 0xf6e8c9,
      size: 3.2,
      speed: 0.008,
      opacity: 0.24,
      blending: THREE.NormalBlending,
      drift: "float",
    },
    oldFilm: {
      count: 100,
      color: 0xd9d3ba,
      size: 1.8,
      speed: 0.05,
      opacity: 0.4,
      blending: THREE.NormalBlending,
      drift: "static",
    },
    archive: {
      count: 45,
      color: 0xcbc7b6,
      size: 2,
      speed: 0.01,
      opacity: 0.2,
      blending: THREE.NormalBlending,
      drift: "float",
    },
  };

  let cleanup: (() => void) | undefined;


  /* =====================================================
     SETUP
     ===================================================== */

  async function setupHistoricalMaterial() {

    cleanup?.();

    const root =
      document.querySelector<HTMLElement>("[data-historical-material]");

    if (!root) {
      return;
    }

    const { resolveHistoricalExperience } = await import(
      "../../lib/experience/resolver"
    );

    /* =====================================================
       ELEMENTS
       ===================================================== */

    const base = root.querySelector<HTMLElement>(".historical-material-base");
    const light = root.querySelector<HTMLElement>(".historical-material-light");
    const grain = root.querySelector<HTMLElement>(".historical-material-grain");
    const fibers = root.querySelector<HTMLElement>(".historical-material-fibers");
    const wear = root.querySelector<HTMLElement>(".historical-material-wear");
    const vibeTint = root.querySelector<HTMLElement>(".historical-material-vibe-tint");
    const canvas = root.querySelector<HTMLCanvasElement>("[data-historical-particles]");

    const reducedMotion =
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animeInstances: any[] = [];
    const gsapTimelines: gsap.core.Timeline[] = [];

    /* =====================================================
       ANIME.JS -- SLOW MATERIAL DRIFT (the surface itself
       breathing, independent of era)
       ===================================================== */

    if (!reducedMotion && base) {
      animeInstances.push(
        animeAnimate(base, {
          translateX: ["-0.25%", "0.30%"],
          translateY: ["0.15%", "-0.20%"],
          scale: [1.035, 1.055],
          duration: 24000,
          ease: "inOutSine",
          alternate: true,
          loop: true,
        }),
      );
    }

    if (!reducedMotion && light) {
      animeInstances.push(
        animeAnimate(light, {
          translateX: ["-1%", "1.2%"],
          translateY: ["-0.6%", "0.8%"],
          scale: [1.14, 1.19],
          opacity: [0.34, 0.48],
          duration: 18000,
          ease: "inOutSine",
          alternate: true,
          loop: true,
        }),
      );
    }

    if (!reducedMotion && grain) {
      animeInstances.push(
        animeAnimate(grain, {
          translateX: ["-0.35%", "0.35%"],
          translateY: ["0.20%", "-0.30%"],
          scale: [1.12, 1.125],
          duration: 14000,
          ease: "linear",
          alternate: true,
          loop: true,
        }),
      );
    }

    if (!reducedMotion && fibers) {
      animeInstances.push(
        animeAnimate(fibers, {
          translateX: ["-0.18%", "0.18%"],
          translateY: ["0.10%", "-0.12%"],
          duration: 28000,
          ease: "inOutSine",
          alternate: true,
          loop: true,
        }),
      );
    }

    if (!reducedMotion && wear) {
      animeInstances.push(
        animeAnimate(wear, {
          translateX: ["-0.10%", "0.10%"],
          translateY: ["0.08%", "-0.08%"],
          duration: 36000,
          ease: "inOutSine",
          alternate: true,
          loop: true,
        }),
      );
    }

    /* =====================================================
       GSAP -- ORGANIC FLICKER PER VIBE

       Torchlight and candlelight don't pulse on a clean sine
       wave -- they gutter irregularly. GSAP's random duration
       per repeat gives that "alive flame" quality that a CSS
       keyframe loop can't.
       ===================================================== */

    function buildFlickerTimeline(target: Element, vibe: EraVibe) {
      if (reducedMotion) return null;

      if (vibe === "firelight" || vibe === "candlelight") {
        const tl = gsap.timeline({ repeat: -1 });
        const baseOpacity = vibe === "firelight" ? 0.55 : 0.48;

        const flicker = () => {
          tl.to(target, {
            opacity: baseOpacity + (Math.random() * 0.18 - 0.06),
            duration: 0.12 + Math.random() * 0.28,
            ease: "sine.inOut",
          });
        };

        for (let i = 0; i < 40; i += 1) flicker();
        return tl;
      }

      if (vibe === "oldFilm") {
        // Occasional reel jitter: a quick vertical hop + brightness pop,
        // like a damaged film frame skipping.
        const tl = gsap.timeline({ repeat: -1, repeatDelay: 0 });

        const jitter = () => {
          const delay = 1.8 + Math.random() * 3.5;
          tl.to(target, { opacity: 0.5, duration: 0.04, delay })
            .to(target, { opacity: 1, duration: 0.06 })
            .to(root!, { y: (Math.random() * 2 - 1), duration: 0.05 })
            .to(root!, { y: 0, duration: 0.08 });
        };

        for (let i = 0; i < 30; i += 1) jitter();
        return tl;
      }

      // Gentle ambient pulse for the remaining vibes
      const tl = gsap.timeline({ repeat: -1, yoyo: true });
      tl.to(target, {
        opacity: "+=0.06",
        duration: 6 + Math.random() * 4,
        ease: "sine.inOut",
      });
      return tl;
    }

    /* =====================================================
       THREE.JS -- LIVE PARTICLE LAYER
       (embers / sand / dust / film grain)
       ===================================================== */

    let renderer: THREE.WebGLRenderer | null = null;
    let scene: THREE.Scene | null = null;
    let camera: THREE.OrthographicCamera | null = null;
    let points: THREE.Points | null = null;
    let velocities: Float32Array | null = null;
    let phases: Float32Array | null = null;
    let rafId = 0;
    let particlesReady = false;

    function disposePoints() {
      if (points && scene) {
        scene.remove(points);
        points.geometry.dispose();
        (points.material as THREE.Material).dispose();
        points = null;
      }
    }

    function buildParticles(vibe: EraVibe) {
      if (!scene) return;

      disposePoints();

      const config = PARTICLE_CONFIGS[vibe];
      const count = reducedMotion ? 0 : config.count;

      const positions = new Float32Array(count * 3);
      velocities = new Float32Array(count * 3);
      phases = new Float32Array(count);

      for (let i = 0; i < count; i += 1) {
        const ix = i * 3;
        positions[ix] = (Math.random() * 2 - 1);
        positions[ix + 1] = (Math.random() * 2 - 1);
        positions[ix + 2] = 0;

        phases[i] = Math.random() * Math.PI * 2;

        if (config.drift === "rise") {
          velocities[ix] = (Math.random() * 2 - 1) * 0.05;
          velocities[ix + 1] = config.speed * (0.6 + Math.random() * 0.8);
        } else if (config.drift === "horizontal") {
          velocities[ix] = config.speed * (0.5 + Math.random() * 0.8);
          velocities[ix + 1] = (Math.random() * 2 - 1) * 0.004;
        } else if (config.drift === "float") {
          velocities[ix] = (Math.random() * 2 - 1) * config.speed;
          velocities[ix + 1] = (Math.random() * 2 - 1) * config.speed;
        } else {
          velocities[ix] = 0;
          velocities[ix + 1] = 0;
        }
      }

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute(
        "position",
        new THREE.BufferAttribute(positions, 3),
      );

      const material = new THREE.PointsMaterial({
        color: config.color,
        size: config.size * 0.008,
        transparent: true,
        opacity: config.opacity,
        blending: config.blending,
        depthWrite: false,
        sizeAttenuation: true,
      });

      points = new THREE.Points(geometry, material);
      scene.add(points);
    }

    function animateParticles() {
      if (points && scene && camera && renderer && velocities && phases) {
        const positionAttr = points.geometry.getAttribute(
          "position",
        ) as THREE.BufferAttribute;
        const arr = positionAttr.array as Float32Array;
        const t = performance.now() * 0.001;

        for (let i = 0; i < arr.length / 3; i += 1) {
          const ix = i * 3;

          arr[ix] += velocities[ix] * 0.02;
          arr[ix + 1] += velocities[ix + 1] * 0.02;

          // gentle turbulence so "float" and "rise" don't look mechanical
          arr[ix] += Math.sin(t * 0.6 + phases[i]) * 0.0006;

          // wrap around edges so particles loop seamlessly
          if (arr[ix] > 1.1) arr[ix] = -1.1;
          if (arr[ix] < -1.1) arr[ix] = 1.1;
          if (arr[ix + 1] > 1.1) arr[ix + 1] = -1.1;
          if (arr[ix + 1] < -1.1) arr[ix + 1] = 1.1;
        }

        positionAttr.needsUpdate = true;
        renderer.render(scene, camera);
      }

      rafId = requestAnimationFrame(animateParticles);
    }

    function resizeRenderer() {
      if (!renderer || !camera || !canvas) return;
      const width = canvas.clientWidth || window.innerWidth;
      const height = canvas.clientHeight || window.innerHeight;
      const aspect = width / height;

      renderer.setSize(width, height, false);
      camera.left = -aspect;
      camera.right = aspect;
      camera.top = 1;
      camera.bottom = -1;
      camera.updateProjectionMatrix();
    }

    function initParticles(vibe: EraVibe) {
      if (!canvas || !root || reducedMotion) return;

      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: false,
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        scene = new THREE.Scene();
        camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 10);
        camera.position.z = 1;

        resizeRenderer();
        buildParticles(vibe);
        animateParticles();

        particlesReady = true;
        root.classList.add("is-particles-ready");
      } catch {
        // WebGL unavailable -- fail silently, CSS layers still carry the look
        particlesReady = false;
      }
    }

    /* =====================================================
       INITIAL VIBE
       ===================================================== */

    const initialVibe = resolveEraVibe(
      root.dataset.eraId ?? "",
      root.dataset.material ?? "",
    );

    root.dataset.eraVibe = initialVibe;

    if (vibeTint) {
      gsapTimelines.push(
        ...([buildFlickerTimeline(vibeTint, initialVibe)].filter(
          Boolean,
        ) as gsap.core.Timeline[]),
      );
    }

    initParticles(initialVibe);

    window.addEventListener("resize", resizeRenderer);

    /* =====================================================
       EXPERIENCE UPDATE (era / world change)
       ===================================================== */

    const updateExperience = (
      worldId: string,
      eraId: string,
      contentType: string,
    ) => {

      const experience = resolveHistoricalExperience(
        worldId,
        eraId,
        contentType,
      );

      const nextVibe = resolveEraVibe(eraId, experience.material);

      root.classList.add("is-transitioning");

      gsap.delayedCall(reducedMotion ? 0 : 0.7, () => {
        root.dataset.worldId = worldId;
        root.dataset.eraId = eraId;
        root.dataset.contentType = contentType;
        root.dataset.material = experience.material;
        root.dataset.texture = experience.texture;
        root.dataset.headingTreatment = experience.titleMotion;
        root.dataset.atmosphere = experience.atmosphere;
        root.dataset.atmosphereIntensity = String(experience.intensity);
        root.dataset.eraVibe = nextVibe;

        // Restart flicker timeline for the new vibe
        gsapTimelines.forEach((tl) => tl.kill());
        gsapTimelines.length = 0;
        if (vibeTint) {
          const tl = buildFlickerTimeline(vibeTint, nextVibe);
          if (tl) gsapTimelines.push(tl);
        }

        // Rebuild particle system for the new vibe
        if (particlesReady) buildParticles(nextVibe);

        root.classList.remove("is-transitioning");
      });
    };

    const handleTimelineChange = (event: Event) => {
      const customEvent = event as CustomEvent<{
        worldId?: string;
        eraId?: string;
      }>;

      const worldId = customEvent.detail?.worldId ?? root.dataset.worldId;
      const eraId = customEvent.detail?.eraId ?? root.dataset.eraId;
      const contentType = root.dataset.contentType ?? "overview";

      if (!worldId || !eraId) return;

      updateExperience(worldId, eraId, contentType);
    };

    window.addEventListener("aion:timeline-change", handleTimelineChange);

    /* =====================================================
       PAUSE WHEN TAB HIDDEN (saves battery/GPU)
       ===================================================== */

    const handleVisibility = () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
        gsapTimelines.forEach((tl) => tl.pause());
      } else if (particlesReady) {
        animateParticles();
        gsapTimelines.forEach((tl) => tl.play());
      }
    };

    document.addEventListener("visibilitychange", handleVisibility);

    /* =====================================================
       CLEANUP
       ===================================================== */

    cleanup = () => {
      window.removeEventListener("aion:timeline-change", handleTimelineChange);
      window.removeEventListener("resize", resizeRenderer);
      document.removeEventListener("visibilitychange", handleVisibility);

      animeInstances.forEach((instance) => {
        try {
          instance.pause?.();
        } catch {
          /* no-op */
        }
      });

      gsapTimelines.forEach((tl) => tl.kill());

      cancelAnimationFrame(rafId);
      disposePoints();
      renderer?.dispose();
      renderer = null;
      scene = null;
      camera = null;
    };
  }


  /* =====================================================
     INITIALIZE
     ===================================================== */

  setupHistoricalMaterial();

  document.addEventListener("astro:after-swap", setupHistoricalMaterial);
</script>