---
import {
  resolveHistoricalExperience,
} from "../../lib/experience/resolver";

interface Props {
  worldId: string;
  eraId: string;
  contentType?: string;
}

const {
  worldId,
  eraId,
  contentType = "overview",
} = Astro.props;

const experience =
  resolveHistoricalExperience(
    worldId,
    eraId,
    contentType,
  );

/* =========================================================
   ERA -> VIBE (SERVER-SIDE, FOR NO-FLASH INITIAL PAINT)

   This is a standalone fallback so the component works even
   if `resolver.ts` doesn't yet return a `vibe`. If your
   resolver already knows the era's cultural period, prefer
   wiring `experience.vibe` through instead and deleting this.

   A "vibe" controls PHYSICAL behavior, not just color:
   - firelight   : Paleolithic / Stone Age        -> rising embers, torchlight flicker
   - desertHeat  : Bronze Age / Egypt / Mesopotamia -> drifting sand, heat shimmer
   - marbleHall  : Classical Greece / Rome         -> dust suspended in light shafts
   - candlelight : Medieval                        -> floating motes, candle flicker
   - painterly   : Renaissance / Baroque           -> slow golden light bloom
   - oldFilm     : Industrial / Victorian / Colonial -> sepia grain, film jitter
   - archive     : Modern / Contemporary           -> quiet, minimal dust
   ========================================================= */

type EraVibe =
  | "firelight"
  | "desertHeat"
  | "marbleHall"
  | "candlelight"
  | "painterly"
  | "oldFilm"
  | "archive";

const ERA_KEYWORD_VIBES: [RegExp, EraVibe][] = [
  [/paleo|stone.?age|prehistor|ice.?age|neolithic/i, "firelight"],
  [/egypt|bronze.?age|mesopotam|sumer|babylon|pharaoh/i, "desertHeat"],
  [/gree|rome|roman|classical|antiquit|hellenis/i, "marbleHall"],
  [/medieval|middle.?ages|feudal|byzant|crusad/i, "candlelight"],
  [/renaissance|baroque/i, "painterly"],
  [/industrial|victorian|colonial|19th/i, "oldFilm"],
  [/modern|contemporary|20th|21st/i, "archive"],
];

const MATERIAL_VIBE_FALLBACK: Record<string, EraVibe> = {
  stone: "marbleHall",
  clay: "desertHeat",
  parchment: "candlelight",
  scroll: "candlelight",
  paper: "painterly",
  archival: "archive",
};

function resolveEraVibe(eraId: string, material: string): EraVibe {
  for (const [pattern, vibe] of ERA_KEYWORD_VIBES) {
    if (pattern.test(eraId)) return vibe;
  }
  return MATERIAL_VIBE_FALLBACK[material] ?? "archive";
}

const eraVibe = resolveEraVibe(eraId, experience.material);
---

<div
  class="historical-material"
  data-historical-material
  data-world-id={worldId}
  data-era-id={eraId}
  data-content-type={contentType}
  data-material={experience.material}
  data-texture={experience.texture}
  data-heading-treatment={experience.titleMotion}
  data-atmosphere={experience.atmosphere}
  data-atmosphere-intensity={experience.intensity}
  data-era-vibe={eraVibe}
  aria-hidden="true"
>
  <div class="historical-material-base"></div>
  <div class="historical-material-light"></div>
  <div class="historical-material-grain"></div>
  <div class="historical-material-fibers"></div>
  <div class="historical-material-wear"></div>
  <div class="historical-material-atmosphere"></div>
  <div class="historical-material-vibe-tint"></div>
  <canvas class="historical-material-particles" data-historical-particles></canvas>
  <div class="historical-material-vignette"></div>
</div>

