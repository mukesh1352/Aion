---
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

import {
  getTimeline,
  formatHistoricalYear,
} from "../../lib/timeline";

import { getStoredEra } from "../../lib/timeline-state";

import PeopleCarousel from "./PeopleCarousel.astro";
import StoriesGallery from "./StoriesGallery.astro";
import FactsWall from "./FactsWall.astro";

import "./india-content.css";
import PlacesList from "./PlacesList.astro";

interface Props {
  worldId: string;
}

const { worldId } = Astro.props;

/* ==========================================================
   TIMELINE
   ========================================================== */

const timeline = getTimeline(worldId);

/* ==========================================================
   CONTENT
   ========================================================== */

const content = await getCollection(
  "historicalContent",
);

const worldContent = content.filter(
  (item) =>
    item.data.world === worldId,
);

/* ==========================================================
   SERVER-SIDE INITIAL ERA
   ========================================================== */

/**
 * Determine which era contains the timeline's
 * default year.
 *
 * Example:
 * India default year = 1947
 * → Modern India
 */

const defaultEra =
  timeline.eras.find(
    (era) =>
      timeline.defaultYear >= era.start &&
      timeline.defaultYear <= era.end,
  ) ?? timeline.eras[0];

if (!defaultEra) {
  throw new Error(
    `AION: Timeline "${worldId}" has no eras.`,
  );
}

/* ==========================================================
   CONTENT BY ERA
   ========================================================== */

type HistoricalEntry =
  CollectionEntry<"historicalContent">;

const contentByEra =
  timeline.eras.map(
    (era) => {
      const eraContent =
        worldContent.filter(
          (item) =>
            item.data.era === era.id,
        );

      const people =
        eraContent.filter(
          (item) =>
            item.data.type === "person",
        ) as HistoricalEntry[];

      const places =
        eraContent.filter(
          (item) =>
            item.data.type === "place",
        ) as HistoricalEntry[];

      const stories =
        eraContent.filter(
          (item) =>
            item.data.type === "story",
        ) as HistoricalEntry[];

      const facts =
        eraContent.filter(
          (item) =>
            item.data.type === "fact",
        ) as HistoricalEntry[];

      const events =
        eraContent.filter(
          (item) =>
            item.data.type === "event",
        ) as HistoricalEntry[];

      return {
        era,
        people,
        places,
        stories,
        facts,
        events,
      };
    },
  );
---
<section
  class="india-content"
  data-india-content
  data-world-id={worldId}
  data-default-era={defaultEra.id}
>
  {
    contentByEra.map(
      ({
        era,
        people,
        places,
        stories,
        facts,
        events,
      }) => (
        <article
          class:list={[
            "era-content",
            {
              "is-active":
                era.id ===
                defaultEra.id,
            },
          ]}
          data-era-content={era.id}
        >

          <!-- ==================================================
               ERA HEADER
               ================================================== -->

          <header class="era-heading">
            <div class="era-heading-main">
              <span class="era-eyebrow">
                {formatHistoricalYear(
                  era.start,
                )}
                {" — "}
                {formatHistoricalYear(
                  era.end,
                )}
              </span>

              <h2>
                {era.label}
              </h2>
            </div>
          </header>

          <!-- ==================================================
               PEOPLE
               ================================================== -->

          {
            people.length > 0 && (
              <section
                class="era-content-section era-people"
                data-content-section="people"
              >
                <PeopleCarousel
                  people={people}
                />
              </section>
            )
          }

          <!-- ==================================================
               PLACES
               ================================================== -->

          {
            places.length > 0 && (
              <section
                class="era-content-section era-places"
                data-content-section="places"
              >
                <PlacesList
                  places={places}
                />
              </section>
            )
          }

          <!-- ==================================================
               STORIES
               ================================================== -->

          {
            stories.length > 0 && (
              <section
                class="era-content-section era-stories"
                data-content-section="stories"
              >
                <StoriesGallery
                  stories={stories}
                />
              </section>
            )
          }

          <!-- ==================================================
               FACTS
               ================================================== -->

          {
            facts.length > 0 && (
              <section
                class="era-content-section era-facts"
                data-content-section="facts"
              >
                <FactsWall
                  facts={facts}
                />
              </section>
            )
          }

          <!-- ==================================================
               EVENTS
               ================================================== -->

          {
            events.length > 0 && (
              <section
                class="era-events-placeholder"
                data-content-section="events"
                aria-hidden="true"
              >
                <!--
                  Events are currently represented by the
                  historical timeline.

                  A dedicated event stream will be added
                  separately so chronology remains distinct
                  from the editorial content sections.
                -->
              </section>
            )
          }

          <!-- ==================================================
               EMPTY ERA
               ================================================== -->

          {
            people.length === 0 &&
            places.length === 0 &&
            stories.length === 0 &&
            facts.length === 0 &&
            events.length === 0 && (
              <section class="empty-era">
                <span class="section-kicker">
                  HISTORICAL CONTENT
                </span>

                <p>
                  No historical material has been
                  added to this era yet.
                </p>
              </section>
            )
          }

        </article>
      ),
    )
  }
</section>

<script>
  import { getStoredEra } from "../../lib/timeline-state";

  /* ==========================================================
     TYPES
     ========================================================== */

  interface PeopleCarouselBridge {
    refresh: () => void;
  }

  interface CarouselSection
    extends HTMLElement {
    __aionPeopleCarousel?: PeopleCarouselBridge;
  }

  interface TimelineChangeDetail {
    worldId: string;
    eraId: string;
  }

  /* ==========================================================
     INDIA CONTENT CONTROLLER
     ========================================================== */

  class IndiaContentController {
    private root: HTMLElement;

    private worldId: string;

    private carousels: Map<
      string,
      PeopleCarouselBridge
    > = new Map();

    constructor(root: HTMLElement) {
      this.root = root;

      this.worldId =
        root.dataset.worldId ??
        "india";

      /*
       * PeopleCarousel scripts are initialized
       * independently by Astro.
       */

      this.collectCarousels();

      /*
       * Listen for timeline changes.
       */

      document.addEventListener(
        "aion:timeline-change",
        this.handleTimelineChange,
      );

      /*
       * Restore the user's previously selected
       * era when possible.
       */

      const storedEra =
        getStoredEra(this.worldId);

      const initialEra =
        storedEra ??
        root.dataset.defaultEra ??
        "";

      /*
       * Wait one animation frame so all child
       * PeopleCarousel scripts have had an
       * opportunity to initialize.
       */

      requestAnimationFrame(() => {
        this.collectCarousels();

        this.updateEra(
          initialEra,
        );
      });
    }

    /* ========================================================
       COLLECT PEOPLE CAROUSELS
       ======================================================== */

    private collectCarousels() {
      this.carousels.clear();

      const sections =
        this.root.querySelectorAll<CarouselSection>(
          "[data-carousel-section]",
        );

      sections.forEach(
        (section) => {
          const eraElement =
            section.closest<HTMLElement>(
              "[data-era-content]",
            );

          const eraId =
            eraElement?.dataset.eraContent;

          const carousel =
            section.__aionPeopleCarousel;

          if (
            eraId &&
            carousel
          ) {
            this.carousels.set(
              eraId,
              carousel,
            );
          }
        },
      );
    }

    /* ========================================================
       TIMELINE CHANGE
       ======================================================== */

    private handleTimelineChange = (
      event: Event,
    ) => {
      const customEvent =
        event as CustomEvent<TimelineChangeDetail>;

      const detail =
        customEvent.detail;

      if (!detail) {
        return;
      }

      /*
       * Ignore timeline events belonging
       * to another world.
       */

      if (
        detail.worldId !==
        this.worldId
      ) {
        return;
      }

      this.updateEra(
        detail.eraId,
      );
    };

    /* ========================================================
       UPDATE ACTIVE ERA
       ======================================================== */

    private updateEra(
      eraId: string,
    ) {
      if (!eraId) {
        return;
      }

      /*
       * Show only the selected era.
       */

      this.root
        .querySelectorAll<HTMLElement>(
          "[data-era-content]",
        )
        .forEach(
          (element) => {
            const active =
              element.dataset
                .eraContent ===
              eraId;

            element.classList.toggle(
              "is-active",
              active,
            );
          },
        );

      /*
       * The selected era was previously
       * display:none.
       *
       * The browser therefore may not have
       * calculated its dimensions yet.
       *
       * Wait for the DOM to paint, then
       * refresh its 3D People carousel.
       */

      requestAnimationFrame(() => {
        this.collectCarousels();

        const carousel =
          this.carousels.get(
            eraId,
          );

        carousel?.refresh();
      });
    }

    /* ========================================================
       DESTROY
       ======================================================== */

    public destroy() {
      document.removeEventListener(
        "aion:timeline-change",
        this.handleTimelineChange,
      );

      this.carousels.clear();
    }
  }

  /* ==========================================================
     INITIALIZE
     ========================================================== */

  const roots =
    document.querySelectorAll<HTMLElement>(
      "[data-india-content]",
    );

  roots.forEach(
    (root) => {
      new IndiaContentController(
        root,
      );
    },
  );
</script>