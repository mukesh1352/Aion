---
import {
  getCollection,
  render,
} from "astro:content";

import Layout from "../../layouts/Layout.astro";

import HistoricalMaterial
  from "../../components/history/HistoricalMaterial.astro";

import {
  resolveExperience,
} from "../../lib/experience/resolver";

import {
  buildEntityIndex,
} from "../../lib/knowledge/entities";

import {
  detectEntityReferences,
} from "../../lib/knowledge/references";

import {
  resolveReferences,
} from "../../lib/knowledge/resolver";

/* =====================================================
   STATIC PATHS
   ===================================================== */

export async function getStaticPaths() {
  const entries =
    await getCollection("historicalContent");

  return entries.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: {
      entry,
    },
  }));
}


/* =====================================================
   CONTENT
   ===================================================== */

const { entry } = Astro.props;

const { Content } = await render(entry);

const data = entry.data;


/* =====================================================
   AION ENTITY REFERENCES
   =====================================================

   References are derived from the article itself.

   Contributors do NOT need to maintain a manual
   "related people", "related places", etc. list.

   Example Markdown:

   Chandragupta Maurya founded the Mauryan kingdom
   with the help of Chanakya.

   If both entities exist in AION:

       Chandragupta Maurya
              ↓
          Chanakya

   becomes a navigable relationship automatically.

   If Chanakya is added later, the relationship
   automatically becomes available on the next build.
   ===================================================== */

const allEntries =
  await getCollection("historicalContent");

const entityIndex =
  buildEntityIndex(allEntries);


/*
 * The current first-generation detector operates
 * against the Markdown body.
 *
 * This will later be upgraded to a Markdown AST
 * extractor so that existing links, code blocks,
 * image syntax, etc. are ignored safely.
 */
const detectedReferences =
  detectEntityReferences(
    entry.body ?? "",
    entityIndex,
  );


/*
 * Convert entity IDs into navigation-ready entities.
 */
const resolvedReferences =
  resolveReferences(
    detectedReferences,
    entityIndex,
  );


/*
 * Only show:
 *
 * 1. resolved entities
 * 2. entities different from the current page
 * 3. one card per entity
 *
 * Multiple mentions of Chanakya inside an article
 * should still produce only one related item.
 */
const relatedReferences =
  Array.from(
    new Map(
      resolvedReferences
        .filter(
          (reference) =>
            reference.resolved &&
            reference.entityId !== data.id &&
            reference.href !== null,
        )
        .map(
          (reference) => [
            reference.entityId,
            reference,
          ],
        ),
    ).values(),
  );


/* =====================================================
   AION EXPERIENCE
   ===================================================== */

/**
 * The visual experience is determined by:
 *
 * WORLD
 *   +
 * ERA
 *   +
 * CONTENT TYPE
 *
 * Example:
 *
 *   india:classical-india:person
 *
 * or:
 *
 *   india:modern-india:person
 *
 * The experience engine remains completely independent
 * from the reference system.
 */

const experience =
  resolveExperience(
    data.world,
    data.era,
    data.type,
  );
---

<Layout
  title={`${data.title} — AION`}
  description={data.summary}
>
  <main
    class="historical-entry"
    data-world-id={data.world}
    data-era-id={data.era}
    data-content-type={data.type}
    data-material={experience.material}
    data-texture={experience.texture}
    data-typography={experience.typography}
    data-title-motion={experience.titleMotion}
    data-interaction={experience.interaction}
    data-atmosphere={experience.atmosphere}
  >

    <!-- =================================================
         HISTORICAL MATERIAL
         ================================================= -->

    <HistoricalMaterial
      worldId={data.world}
      eraId={data.era}
      contentType={data.type}
    />


    <!-- =================================================
         ARTICLE SHELL
         ================================================= -->

    <div class="historical-entry-shell">


      <!-- =================================================
           HEADER
           ================================================= -->

      <header
        class="historical-entry-header"
        data-entry-header
      >

        <!-- BACK -->

        <a
          href="/india"
          class="historical-back"
          data-entry-element
        >
          <span class="back-mark">
            ←
          </span>

          <span>
            INDIA
          </span>
        </a>


        <!-- META -->

        <div
          class="historical-entry-meta"
          data-entry-element
        >
          <span class="historical-type">
            {data.type.toUpperCase()}
          </span>

          <span class="historical-status">
            {data.status
              .replaceAll("-", " ")
              .toUpperCase()}
          </span>
        </div>


        <!-- =================================================
             TITLE
             ================================================= -->

        <div
          class="historical-title-wrap"
          data-entry-title-wrap
        >

          <!-- Physical/depth shadow -->

          <div
            class="historical-title-shadow"
            aria-hidden="true"
          >
            {data.title}
          </div>


          <!-- Actual title -->

          <h1 data-entry-title>
            {data.title}
          </h1>


          <!-- Surface highlight -->

          <div
            class="historical-title-highlight"
            aria-hidden="true"
          >
            {data.title}
          </div>


          <!-- Moving material light -->

          <div
            class="historical-title-light"
            aria-hidden="true"
          >
          </div>

        </div>


        <!-- =================================================
             SUBTITLE
             ================================================= -->

        {
          data.subtitle && (
            <p
              class="historical-subtitle"
              data-entry-element
            >
              {data.subtitle}
            </p>
          )
        }


        <!-- =================================================
             SUMMARY
             ================================================= -->

        <p
          class="historical-summary"
          data-entry-element
        >
          {data.summary}
        </p>


        <!-- =================================================
             TAGS
             ================================================= -->

        {
          data.tags &&
          data.tags.length > 0 && (
            <div
              class="historical-tags"
              data-entry-tags
            >
              {
                data.tags.map((tag) => (
                  <span>
                    {tag}
                  </span>
                ))
              }
            </div>
          )
        }


        <!-- =================================================
             HEADER RULE
             ================================================= -->

        <div
          class="historical-header-rule"
          aria-hidden="true"
        >
          <span></span>
        </div>

      </header>


      <!-- =================================================
           MARKDOWN CONTENT
           ================================================= -->

      <article
        class="historical-entry-body"
        data-historical-body
      >
        <Content />
      </article>


      <!-- =================================================
           RELATED TO STUDY
           =================================================

           This section is generated automatically from
           references detected inside the Markdown.

           There is NO manual related-content list here.
           ================================================= -->

      {
        relatedReferences.length > 0 && (
          <section
            class="historical-related"
            aria-labelledby="historical-related-title"
            data-related-section
          >

            <div class="historical-related-header">
              <span class="historical-related-eyebrow">
                CONTINUE EXPLORING
              </span>

              <h2
                id="historical-related-title"
                class="historical-related-title"
              >
                Related to Study
              </h2>

              <p class="historical-related-introduction">
                People, places, events, stories, and facts
                mentioned in this account.
              </p>
            </div>


            <div class="historical-related-list">

              {
                relatedReferences.map((reference) => (
                  <a
                    href={reference.href ?? "#"}
                    class="historical-related-item"
                    data-related-item
                  >

                    <span class="historical-related-type">
                      {reference.type.toUpperCase()}
                    </span>

                    <span class="historical-related-name">
                      {reference.title}
                    </span>

                    <span
                      class="historical-related-arrow"
                      aria-hidden="true"
                    >
                      →
                    </span>

                  </a>
                ))
              }

            </div>

          </section>
        )
      }

    </div>

  </main>
</Layout>
<style>

/* =========================================================
   AION HISTORICAL TYPOGRAPHY
   ========================================================= */

:global(:root) {
  --aion-font-ui:
    "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  --aion-font-inscription:
    "Cinzel Decorative",
    "Cinzel",
    Georgia,
    serif;

  --aion-font-scripture:
    "IM FELL English",
    "IM FELL English SC",
    Georgia,
    "Times New Roman",
    serif;

  --aion-font-display:
    "Cormorant Garamond",
    Georgia,
    "Times New Roman",
    serif;

  --aion-font-archival:
    "Special Elite",
    "Courier Prime",
    "Courier New",
    monospace;

  --aion-font-reading:
    "Source Serif 4",
    Georgia,
    "Times New Roman",
    serif;
}


/* =========================================================
   PAGE
   ========================================================= */

.historical-entry {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  isolation: isolate;
  background: transparent;
  color: #e8e3d8;
}


/* =========================================================
   ARTICLE SHELL
   ========================================================= */

.historical-entry-shell {
  position: relative;
  z-index: 2;
  width: 100%;
}


/* =========================================================
   HEADER
   ========================================================= */

.historical-entry-header {
  width: min(
    920px,
    calc(100% - 48px)
  );

  margin: 0 auto;
  padding: 110px 0 100px;
}


/* =========================================================
   BACK
   ========================================================= */

.historical-back {
  display: inline-flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 58px;

  color: rgba(200, 161, 90, 0.72);

  font-family: var(--aion-font-ui);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.22em;

  text-decoration: none;

  transition:
    color 240ms ease;
}

.historical-back:hover {
  color: #e8e3d8;
}

.back-mark {
  font-size: 15px;
  line-height: 1;

  transition:
    transform 300ms ease;
}

.historical-back:hover .back-mark {
  transform: translateX(-5px);
}


/* =========================================================
   META
   ========================================================= */

.historical-entry-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;

  margin-bottom: 30px;

  font-family: var(--aion-font-ui);
}

.historical-type,
.historical-status {
  color: rgba(200, 161, 90, 0.68);

  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.19em;
}

.historical-status {
  color: rgba(232, 227, 216, 0.38);
}

.historical-type::after {
  content: "·";

  margin-left: 14px;

  color: rgba(200, 161, 90, 0.30);
}


/* =========================================================
   TITLE WRAPPER
   ========================================================= */

.historical-title-wrap {
  position: relative;
  width: fit-content;
  max-width: 100%;

  overflow: visible;

  transform-origin: center left;

  will-change: transform;
}


/* =========================================================
   MAIN TITLE
   ========================================================= */

.historical-entry-header h1 {
  position: relative;
  z-index: 3;

  max-width: 900px;

  margin: 0;

  color: #e8e3d8;

  font-family: var(--aion-font-inscription);

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight: 400;

  line-height: 0.90;

  letter-spacing: -0.025em;

  text-wrap: balance;

  will-change:
    transform,
    opacity,
    filter,
    letter-spacing;
}


/* =========================================================
   TITLE SHADOW
   ========================================================= */

.historical-title-shadow {
  position: absolute;
  z-index: 1;
  inset: 0;

  color: rgba(0, 0, 0, 0.55);

  font-family: inherit;

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight: 400;

  line-height: 0.90;

  letter-spacing: -0.025em;

  transform: translate(0, 3px);

  pointer-events: none;
}


/* =========================================================
   TITLE HIGHLIGHT
   ========================================================= */

.historical-title-highlight {
  position: absolute;
  z-index: 4;
  inset: 0;

  color: transparent;

  font-family: inherit;

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight: 400;

  line-height: 0.90;

  letter-spacing: -0.025em;

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.16),
      transparent 35%
    );

  background-clip: text;
  -webkit-background-clip: text;

  pointer-events: none;

  opacity: 0.45;
}


/* =========================================================
   TITLE LIGHT
   ========================================================= */

.historical-title-light {
  position: absolute;
  z-index: 5;

  top: -20%;
  left: -30%;

  width: 35%;
  height: 150%;

  opacity: 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255, 240, 195, 0.18),
      transparent
    );

  transform:
    skewX(-18deg)
    translateX(-180%);

  pointer-events: none;
}


/* =========================================================
   TYPOGRAPHY
   ========================================================= */

.historical-entry[data-typography="inscription"]
.historical-entry-header h1 {
  font-family: var(--aion-font-inscription);
  font-weight: 400;
  letter-spacing: -0.025em;
}

.historical-entry[data-typography="manuscript"]
.historical-entry-header h1 {
  font-family: var(--aion-font-scripture);
  font-weight: 400;
  letter-spacing: -0.01em;
}

.historical-entry[data-typography="historical-display"]
.historical-entry-header h1 {
  font-family: var(--aion-font-display);
  font-weight: 500;
  letter-spacing: -0.035em;
}

.historical-entry[data-typography="archival"]
.historical-entry-header h1 {
  font-family: var(--aion-font-archival);

  font-weight: 400;

  font-size:
    clamp(
      2.6rem,
      6vw,
      5rem
    );

  letter-spacing: 0.01em;

  text-transform: uppercase;
}

.historical-entry[data-typography="plain"]
.historical-entry-header h1 {
  font-family: var(--aion-font-ui);
  font-weight: 600;
  letter-spacing: -0.02em;
}


/* =========================================================
   TITLE MOTION
   ========================================================= */

.historical-entry[data-title-motion="engrave"]
.historical-entry-header h1 {
  text-shadow:
    0 1px 0 rgba(255, 255, 255, 0.08),
    0 -1px 0 rgba(0, 0, 0, 0.55),
    0 5px 18px rgba(0, 0, 0, 0.55);
}

.historical-entry[data-title-motion="ink"]
.historical-entry-header h1 {
  text-shadow:
    0 2px 8px rgba(20, 12, 4, 0.45);
}

.historical-entry[data-title-motion="ink"]
.historical-title-highlight {
  opacity: 0.30;

  background:
    linear-gradient(
      180deg,
      rgba(255, 244, 214, 0.10),
      transparent 40%
    );
}

.historical-entry[data-title-motion="dust"]
.historical-entry-header h1 {
  text-shadow:
    0 3px 20px rgba(0, 0, 0, 0.40);
}

.historical-entry[data-title-motion="dust"]
.historical-title-highlight {
  opacity: 0.22;
}

.historical-entry[data-title-motion="print"]
.historical-entry-header h1 {
  text-shadow:
    0 2px 12px rgba(0, 0, 0, 0.38);
}

.historical-entry[data-title-motion="print"]
.historical-title-highlight {
  opacity: 0.18;
}

.historical-entry[data-title-motion="plain"]
.historical-entry-header h1 {
  text-shadow: none;
}

.historical-entry[data-title-motion="plain"]
.historical-title-shadow,
.historical-entry[data-title-motion="plain"]
.historical-title-highlight,
.historical-entry[data-title-motion="plain"]
.historical-title-light {
  display: none;
}


/* =========================================================
   SUBTITLE
   ========================================================= */

.historical-subtitle {
  max-width: 680px;

  margin: 32px 0 0;

  color: rgba(200, 161, 90, 0.82);

  font-family: var(--aion-font-scripture);

  font-size:
    clamp(
      1.2rem,
      2vw,
      1.55rem
    );

  font-weight: 400;
  font-style: italic;

  line-height: 1.55;
}


/* =========================================================
   SUMMARY
   ========================================================= */

.historical-summary {
  max-width: 680px;

  margin: 34px 0 0;

  color: rgba(232, 227, 216, 0.62);

  font-family: var(--aion-font-reading);

  font-size: 17px;
  line-height: 1.9;
}


/* =========================================================
   TAGS
   ========================================================= */

.historical-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;

  margin-top: 32px;

  font-family: var(--aion-font-ui);
}

.historical-tags span {
  padding: 5px 9px;

  border:
    1px solid
    rgba(232, 227, 216, 0.08);

  background:
    rgba(21, 24, 29, 0.16);

  color:
    rgba(232, 227, 216, 0.38);

  font-size: 9px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}


/* =========================================================
   HEADER RULE
   ========================================================= */

.historical-header-rule {
  width: 100%;
  height: 1px;

  margin-top: 88px;

  overflow: hidden;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(200, 161, 90, 0.10),
      transparent
    );
}

.historical-header-rule span {
  display: block;

  width: 30%;
  height: 1px;

  background:
    rgba(200, 161, 90, 0.42);

  transform: scaleX(0);
  transform-origin: left center;
}


/* =========================================================
   MARKDOWN BODY
   ========================================================= */

.historical-entry-body {
  width: min(
    760px,
    calc(100% - 48px)
  );

  margin: 0 auto;

  padding:
    10px 0 180px;

  color:
    rgba(232, 227, 216, 0.78);

  font-family:
    var(--aion-font-reading);

  font-size: 19px;
  line-height: 2;
}


/* =========================================================
   MARKDOWN TYPOGRAPHY
   ========================================================= */

.historical-entry[data-typography="manuscript"]
.historical-entry-body :global(h2),
.historical-entry[data-typography="manuscript"]
.historical-entry-body :global(h3) {
  font-family: var(--aion-font-scripture);
}

.historical-entry[data-typography="historical-display"]
.historical-entry-body :global(h2),
.historical-entry[data-typography="historical-display"]
.historical-entry-body :global(h3) {
  font-family: var(--aion-font-display);
}

.historical-entry[data-typography="archival"]
.historical-entry-body :global(h2) {
  font-family: var(--aion-font-archival);
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.historical-entry[data-typography="plain"]
.historical-entry-body :global(h2),
.historical-entry[data-typography="plain"]
.historical-entry-body :global(h3) {
  font-family: var(--aion-font-ui);
}


/* =========================================================
   HISTORICAL SECTION
   ========================================================= */

.historical-entry-body
:global(.historical-section) {
  position: relative;

  margin: 150px 0;

  will-change:
    transform,
    opacity;
}


/* =========================================================
   SECTION HEADING
   ========================================================= */

.historical-entry-body :global(h2) {
  position: relative;

  margin: 0 0 36px;

  color: #e8e3d8;

  font-family: var(--aion-font-scripture);

  font-size:
    clamp(
      2.25rem,
      4vw,
      3.5rem
    );

  font-weight: 400;

  line-height: 1.08;

  letter-spacing: -0.015em;

  scroll-margin-top: 120px;

  will-change:
    transform,
    opacity,
    filter,
    clip-path;
}

.historical-entry-body
:global(h2::after) {
  content: "";

  display: block;

  width: 70px;
  height: 1px;

  margin-top: 22px;

  background:
    rgba(200, 161, 90, 0.42);

  transform:
    scaleX(1);

  transform-origin:
    left center;
}


/* =========================================================
   H3
   ========================================================= */

.historical-entry-body :global(h3) {
  margin: 72px 0 22px;

  color:
    rgba(232, 227, 216, 0.88);

  font-family:
    var(--aion-font-scripture);

  font-size: 1.7rem;

  font-weight: 400;

  line-height: 1.3;
}


/* =========================================================
   PARAGRAPHS
   ========================================================= */

.historical-entry-body :global(p) {
  max-width: 760px;
  margin: 0 0 30px;
}


/* =========================================================
   FIRST LETTER
   ========================================================= */

.historical-entry-body
:global(
  .historical-section > p:first-of-type::first-letter
) {
  float: left;

  margin:
    8px 10px 0 0;

  color: #c8a15a;

  font-family:
    var(--aion-font-inscription);

  font-size: 3.4em;
  line-height: 0.78;
}


/* =========================================================
   STRONG
   ========================================================= */

.historical-entry-body :global(strong) {
  color: #e8e3d8;
  font-weight: 600;
}


/* =========================================================
   EMPHASIS
   ========================================================= */

.historical-entry-body :global(em) {
  color:
    rgba(232, 227, 216, 0.86);

  font-family:
    var(--aion-font-scripture);
}


/* =========================================================
   LISTS
   ========================================================= */

.historical-entry-body :global(ul),
.historical-entry-body :global(ol) {
  max-width: 760px;

  margin: 34px 0;

  padding-left: 30px;
}

.historical-entry-body :global(li) {
  margin: 11px 0;
}


/* =========================================================
   LINKS
   ========================================================= */

.historical-entry-body :global(a) {
  color: #c8a15a;

  text-decoration: underline;

  text-decoration-color:
    rgba(200, 161, 90, 0.35);

  text-underline-offset: 4px;

  transition:
    color 220ms ease;
}

.historical-entry-body :global(a:hover) {
  color: #e8e3d8;
}


/* =========================================================
   BLOCKQUOTE
   ========================================================= */

.historical-entry-body :global(blockquote) {
  max-width: 720px;

  margin: 64px 0;

  padding:
    12px 0 12px 30px;

  border-left:
    1px solid
    rgba(200, 161, 90, 0.42);

  color:
    rgba(232, 227, 216, 0.58);

  font-family:
    var(--aion-font-scripture);

  font-size: 1.08em;

  font-style: italic;

  line-height: 1.8;
}


/* =========================================================
   IMAGES
   ========================================================= */

.historical-entry-body :global(img) {
  display: block;

  width: 100%;
  height: auto;

  margin: 72px 0;

  border:
    1px solid
    rgba(200, 161, 90, 0.12);

  opacity: 0.92;
}


/* =========================================================
   FIGURES
   ========================================================= */

.historical-entry-body :global(figure) {
  margin: 72px 0;
}

.historical-entry-body :global(figcaption) {
  margin-top: 14px;

  color:
    rgba(232, 227, 216, 0.40);

  font-family:
    var(--aion-font-ui);

  font-size: 10px;

  line-height: 1.6;

  letter-spacing: 0.05em;
}


/* =========================================================
   HORIZONTAL RULE
   ========================================================= */

.historical-entry-body :global(hr) {
  width: 100%;
  height: 1px;

  margin: 100px 0;

  border: 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(200, 161, 90, 0.20),
      transparent
    );
}


/* =========================================================
   CODE
   ========================================================= */

.historical-entry-body :global(code) {
  padding: 2px 6px;

  background:
    rgba(255, 255, 255, 0.035);

  color:
    rgba(232, 227, 216, 0.78);

  font-family:
    monospace;

  font-size: 0.88em;
}


/* =========================================================
   RELATED TO STUDY
   ========================================================= */

.historical-related {
  width: min(
    920px,
    calc(100% - 48px)
  );

  margin:
    0 auto 220px;

  padding-top: 100px;

  border-top:
    1px solid
    rgba(200, 161, 90, 0.12);
}

.historical-related-header {
  max-width: 680px;

  margin-bottom: 48px;
}

.historical-related-eyebrow {
  display: block;

  margin-bottom: 16px;

  color:
    rgba(200, 161, 90, 0.58);

  font-family:
    var(--aion-font-ui);

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.20em;
}

.historical-related-title {
  margin: 0;

  color: #e8e3d8;

  font-family:
    var(--aion-font-scripture);

  font-size:
    clamp(
      2.2rem,
      4vw,
      3.5rem
    );

  font-weight: 400;

  line-height: 1.1;
}

.historical-related-introduction {
  margin:
    18px 0 0;

  color:
    rgba(232, 227, 216, 0.45);

  font-family:
    var(--aion-font-reading);

  font-size: 16px;

  line-height: 1.8;
}


/* =========================================================
   RELATED LIST
   ========================================================= */

.historical-related-list {
  display: grid;

  grid-template-columns:
    repeat(
      2,
      minmax(0, 1fr)
    );

  gap: 1px;

  border:
    1px solid
    rgba(232, 227, 216, 0.08);

  background:
    rgba(232, 227, 216, 0.08);
}


/* =========================================================
   RELATED ITEM
   ========================================================= */

.historical-related-item {
  position: relative;

  display: grid;

  grid-template-columns:
    80px minmax(0, 1fr) 24px;

  align-items: center;

  gap: 20px;

  min-height: 92px;

  padding:
    20px 24px;

  background:
    rgba(8, 10, 13, 0.62);

  color: #e8e3d8;

  text-decoration: none;

  overflow: hidden;

  transition:
    background 280ms ease,
    padding 280ms ease;
}

.historical-related-item::before {
  content: "";

  position: absolute;

  inset:
    0 auto 0 0;

  width: 2px;

  background:
    rgba(200, 161, 90, 0.72);

  transform:
    scaleY(0);

  transform-origin:
    bottom center;

  transition:
    transform 280ms ease;
}

.historical-related-item:hover {
  padding-left: 30px;

  background:
    rgba(21, 24, 29, 0.82);
}

.historical-related-item:hover::before {
  transform:
    scaleY(1);
}


/* =========================================================
   RELATED TYPE
   ========================================================= */

.historical-related-type {
  color:
    rgba(200, 161, 90, 0.62);

  font-family:
    var(--aion-font-ui);

  font-size: 8px;
  font-weight: 600;

  letter-spacing: 0.15em;
}


/* =========================================================
   RELATED NAME
   ========================================================= */

.historical-related-name {
  min-width: 0;

  color:
    rgba(232, 227, 216, 0.84);

  font-family:
    var(--aion-font-reading);

  font-size: 17px;

  line-height: 1.35;
}


/* =========================================================
   RELATED ARROW
   ========================================================= */

.historical-related-arrow {
  color:
    rgba(200, 161, 90, 0.58);

  font-family:
    var(--aion-font-ui);

  font-size: 16px;

  text-align: right;

  transition:
    transform 280ms ease,
    color 280ms ease;
}

.historical-related-item:hover
.historical-related-arrow {
  transform:
    translateX(5px);

  color:
    #e8e3d8;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  .historical-entry-header {
    width:
      calc(100% - 40px);

    padding:
      80px 0;
  }

  .historical-back {
    margin-bottom: 48px;
  }

  .historical-entry-header h1,
  .historical-title-shadow,
  .historical-title-highlight {
    font-size:
      clamp(
        3.1rem,
        15vw,
        5.5rem
      );

    line-height: 0.90;
  }

  .historical-entry[data-typography="archival"]
  .historical-entry-header h1 {
    font-size:
      clamp(
        2.2rem,
        11vw,
        3.6rem
      );
  }

  .historical-subtitle {
    font-size: 1.15rem;
  }

  .historical-summary {
    font-size: 16px;
  }

  .historical-entry-body {
    width:
      calc(100% - 40px);

    font-size: 17px;

    line-height: 1.85;

    padding-bottom:
      120px;
  }

  .historical-entry-body
  :global(.historical-section) {
    margin:
      110px 0;
  }

  .historical-entry-body
  :global(h2) {
    font-size:
      clamp(
        2rem,
        9vw,
        2.8rem
      );
  }

  .historical-entry-body
  :global(
    .historical-section > p:first-of-type::first-letter
  ) {
    font-size: 3em;
  }

  .historical-header-rule {
    margin-top: 64px;
  }


  /* Related */

  .historical-related {
    width:
      calc(100% - 40px);

    margin-bottom: 140px;

    padding-top: 72px;
  }

  .historical-related-list {
    grid-template-columns:
      1fr;
  }

  .historical-related-item {
    grid-template-columns:
      68px minmax(0, 1fr) 20px;

    gap: 12px;

    min-height: 82px;

    padding:
      18px;
  }

  .historical-related-item:hover {
    padding-left: 22px;
  }

  .historical-related-name {
    font-size: 16px;
  }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .historical-entry-body
  :global(.historical-section) {
    opacity: 1 !important;
    transform: none !important;
  }

  .historical-entry-header h1 {
    filter: none !important;
  }

  .historical-related-item,
  .historical-related-arrow,
  .historical-related-item::before {
    transition: none !important;
  }
}

</style>


<script>
  import gsap from "gsap";

  import {
    ScrollTrigger,
  } from "gsap/ScrollTrigger";

  import {
    animate as animeAnimate,
  } from "animejs";


  gsap.registerPlugin(
    ScrollTrigger
  );


  /* =====================================================
     TITLE MOTION CONFIG
     ===================================================== */

  const TITLE_MOTION_CONFIG: Record<
    string,
    {
      initialY: number;
      initialBlur: number;
      initialLetterSpacing: string;
      finalLetterSpacing: string;
      duration: number;
      ease: string;
      shadowInitialY: number;
      shadowFinalOpacity: number;
      highlightInitialY: number;
      highlightFinalOpacity: number;
      showLight: boolean;
    }
  > = {

    engrave: {
      initialY: 55,
      initialBlur: 4,
      initialLetterSpacing: "0.035em",
      finalLetterSpacing: "-0.025em",
      duration: 1.55,
      ease: "power3.out",
      shadowInitialY: 61,
      shadowFinalOpacity: 0.52,
      highlightInitialY: 50,
      highlightFinalOpacity: 0.45,
      showLight: false,
    },

    ink: {
      initialY: 26,
      initialBlur: 3,
      initialLetterSpacing: "0.01em",
      finalLetterSpacing: "-0.01em",
      duration: 1.3,
      ease: "power2.out",
      shadowInitialY: 30,
      shadowFinalOpacity: 0.34,
      highlightInitialY: 22,
      highlightFinalOpacity: 0.30,
      showLight: false,
    },

    dust: {
      initialY: 16,
      initialBlur: 6,
      initialLetterSpacing: "0.02em",
      finalLetterSpacing: "0em",
      duration: 1.8,
      ease: "power1.out",
      shadowInitialY: 18,
      shadowFinalOpacity: 0.28,
      highlightInitialY: 14,
      highlightFinalOpacity: 0.22,
      showLight: false,
    },

    print: {
      initialY: 18,
      initialBlur: 1.5,
      initialLetterSpacing: "0.015em",
      finalLetterSpacing: "-0.035em",
      duration: 1.0,
      ease: "power2.out",
      shadowInitialY: 21,
      shadowFinalOpacity: 0.30,
      highlightInitialY: 16,
      highlightFinalOpacity: 0.18,
      showLight: true,
    },

    plain: {
      initialY: 10,
      initialBlur: 0,
      initialLetterSpacing: "0em",
      finalLetterSpacing: "0em",
      duration: 0.6,
      ease: "power1.out",
      shadowInitialY: 0,
      shadowFinalOpacity: 0,
      highlightInitialY: 0,
      highlightFinalOpacity: 0,
      showLight: false,
    },
  };


  /* =====================================================
     INTERACTION CONFIG
     ===================================================== */

  const INTERACTION_CONFIG: Record<
    string,
    {
      tiltX: number;
      tiltY: number;
      hoverScale: number;
      highlightHoverOpacity: number;
    }
  > = {

    relief: {
      tiltX: 4,
      tiltY: 2.5,
      hoverScale: 1.008,
      highlightHoverOpacity: 0.62,
    },

    ink: {
      tiltX: 1.6,
      tiltY: 1,
      hoverScale: 1.004,
      highlightHoverOpacity: 0.42,
    },

    paper: {
      tiltX: 0.6,
      tiltY: 0.4,
      hoverScale: 1.002,
      highlightHoverOpacity: 0.28,
    },

    none: {
      tiltX: 0,
      tiltY: 0,
      hoverScale: 1,
      highlightHoverOpacity: 0,
    },
  };


  /* =====================================================
     AION HISTORICAL ARTICLE ENGINE
     ===================================================== */

  const entry =
    document.querySelector<HTMLElement>(
      ".historical-entry"
    );

  const header =
    document.querySelector<HTMLElement>(
      "[data-entry-header]"
    );

  const body =
    document.querySelector<HTMLElement>(
      "[data-historical-body]"
    );


  /*
   * Stop safely if this isn't an historical article page.
   */

  if (
    entry &&
    header &&
    body
  ) {

    /* ===================================================
       MOTION PREFERENCE
       =================================================== */

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;


    /* ===================================================
       EXPERIENCE
       =================================================== */

    const titleMotion =
      entry.dataset.titleMotion ??
      "plain";

    const motion =
      TITLE_MOTION_CONFIG[titleMotion] ??
      TITLE_MOTION_CONFIG.plain;

    const interaction =
      entry.dataset.interaction ??
      "none";

    const pointer =
      INTERACTION_CONFIG[interaction] ??
      INTERACTION_CONFIG.none;


    /* ===================================================
       ELEMENTS
       =================================================== */

    const title =
      header.querySelector<HTMLElement>(
        "[data-entry-title]"
      );

    const titleShadow =
      header.querySelector<HTMLElement>(
        ".historical-title-shadow"
      );

    const titleHighlight =
      header.querySelector<HTMLElement>(
        ".historical-title-highlight"
      );

    const titleLight =
      header.querySelector<HTMLElement>(
        ".historical-title-light"
      );

    const titleWrap =
      header.querySelector<HTMLElement>(
        "[data-entry-title-wrap]"
      );

    const headerElements =
      Array.from(
        header.querySelectorAll<HTMLElement>(
          "[data-entry-element]"
        )
      );

    const headerRule =
      header.querySelector<HTMLElement>(
        ".historical-header-rule span"
      );


    /* ===================================================
       OPENING ANIMATION
       =================================================== */

    if (!reducedMotion) {

      gsap.set(
        headerElements,
        {
          opacity: 0,
          y: 18,
        }
      );


      if (title) {
        gsap.set(
          title,
          {
            opacity: 0,
            y: motion.initialY,
            filter:
              `blur(${motion.initialBlur}px)`,
            letterSpacing:
              motion.initialLetterSpacing,
          }
        );
      }


      if (titleShadow) {
        gsap.set(
          titleShadow,
          {
            opacity: 0,
            y: motion.shadowInitialY,
          }
        );
      }


      if (titleHighlight) {
        gsap.set(
          titleHighlight,
          {
            opacity: 0,
            y: motion.highlightInitialY,
          }
        );
      }


      if (titleLight) {
        gsap.set(
          titleLight,
          {
            opacity: 0,
          }
        );
      }


      if (headerRule) {
        gsap.set(
          headerRule,
          {
            scaleX: 0,
            transformOrigin:
              "left center",
          }
        );
      }


      /* =================================================
         INTRO TIMELINE
         ================================================= */

      const intro =
        gsap.timeline({
          defaults: {
            ease:
              "power3.out",
          },
        });


      intro.to(
        headerElements,
        {
          opacity: 1,
          y: 0,
          duration: 0.75,
          stagger: 0.07,
        }
      );


      if (titleShadow) {
        intro.to(
          titleShadow,
          {
            opacity:
              motion.shadowFinalOpacity,
            y: 0,
            duration:
              motion.duration,
            ease:
              "power3.out",
          },
          "-=0.35"
        );
      }


      if (title) {
        intro.to(
          title,
          {
            opacity: 1,
            y: 0,
            filter:
              "blur(0px)",
            letterSpacing:
              motion.finalLetterSpacing,
            duration:
              motion.duration,
            ease:
              motion.ease,
          },
          `-=${Math.min(
            motion.duration * 0.7,
            1.05
          )}`
        );
      }


      if (titleHighlight) {
        intro.to(
          titleHighlight,
          {
            opacity:
              motion.highlightFinalOpacity,
            y: 0,
            duration:
              motion.duration * 0.75,
            ease:
              "power2.out",
          },
          "-=0.9"
        );
      }


      if (
        titleLight &&
        motion.showLight
      ) {

        intro.to(
          titleLight,
          {
            opacity: 0.7,
            duration: 0.25,
          },
          "-=0.25"
        );

        intro.to(
          titleLight,
          {
            xPercent: 600,
            opacity: 0,
            duration: 1.1,
            ease:
              "power2.inOut",
          }
        );
      }


      const supporting =
        header.querySelectorAll(
          ".historical-subtitle, " +
          ".historical-summary, " +
          ".historical-tags"
        );

      if (
        supporting.length > 0
      ) {
        intro.to(
          supporting,
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.08,
          },
          "-=0.65"
        );
      }


      if (headerRule) {
        intro.to(
          headerRule,
          {
            scaleX: 1,
            duration: 1.15,
            ease:
              "power2.out",
          },
          "-=0.55"
        );
      }
    }


    /* ===================================================
       TITLE POINTER INTERACTION
       =================================================== */

    if (
      titleWrap &&
      title &&
      !reducedMotion &&
      (
        pointer.tiltX > 0 ||
        pointer.tiltY > 0
      )
    ) {

      let targetX = 0;
      let targetY = 0;

      let currentX = 0;
      let currentY = 0;


      titleWrap.addEventListener(
        "pointermove",
        (event) => {

          const rect =
            titleWrap.getBoundingClientRect();

          const x =
            (
              event.clientX -
              rect.left
            ) /
            rect.width;

          const y =
            (
              event.clientY -
              rect.top
            ) /
            rect.height;

          targetX =
            (x - 0.5) *
            pointer.tiltX;

          targetY =
            (y - 0.5) *
            pointer.tiltY;
        }
      );


      titleWrap.addEventListener(
        "pointerleave",
        () => {
          targetX = 0;
          targetY = 0;
        }
      );


      const updateRelief =
        () => {

          currentX +=
            (
              targetX -
              currentX
            ) * 0.08;

          currentY +=
            (
              targetY -
              currentY
            ) * 0.08;


          gsap.set(
            title,
            {
              x: currentX,
              y: currentY,
            }
          );


          if (titleHighlight) {
            gsap.set(
              titleHighlight,
              {
                x:
                  currentX * 0.35,
                y:
                  currentY * 0.35,
              }
            );
          }


          if (titleShadow) {
            gsap.set(
              titleShadow,
              {
                x:
                  currentX * -0.18,
                y:
                  currentY * -0.18,
              }
            );
          }


          requestAnimationFrame(
            updateRelief
          );
        };


      updateRelief();
    }


    /* ===================================================
       ANIME.JS MICRO INTERACTION
       =================================================== */

    if (
      titleWrap &&
      !reducedMotion &&
      interaction !== "none"
    ) {

      titleWrap.addEventListener(
        "pointerenter",
        () => {

          try {

            animeAnimate(
              titleWrap,
              {
                scale:
                  pointer.hoverScale,
                duration: 500,
                ease: "out(3)",
              }
            );


            if (titleHighlight) {
              animeAnimate(
                titleHighlight,
                {
                  opacity:
                    pointer.highlightHoverOpacity,
                  duration: 500,
                  ease: "out(3)",
                }
              );
            }

          } catch (error) {

            console.warn(
              "AION: Anime.js interaction failed.",
              error
            );
          }
        }
      );


      titleWrap.addEventListener(
        "pointerleave",
        () => {

          try {

            animeAnimate(
              titleWrap,
              {
                scale: 1,
                duration: 700,
                ease: "out(3)",
              }
            );


            if (titleHighlight) {
              animeAnimate(
                titleHighlight,
                {
                  opacity:
                    motion.highlightFinalOpacity,
                  duration: 700,
                  ease: "out(3)",
                }
              );
            }

          } catch (error) {

            console.warn(
              "AION: Anime.js interaction reset failed.",
              error
            );
          }
        }
      );
    }


    /* ===================================================
       MARKDOWN SECTION SCROLL ANIMATION
       =================================================== */

    const headings =
      Array.from(
        body.querySelectorAll<HTMLElement>(
          ":scope > .historical-section > h2, " +
          ":scope h2"
        )
      );


    /*
     * Older Markdown content may not have
     * `.historical-section` wrappers.
     *
     * In that case we simply animate headings
     * directly.
     */

    if (
      !reducedMotion &&
      headings.length > 0
    ) {

      headings.forEach(
        (heading) => {

          const section =
            heading.closest<HTMLElement>(
              ".historical-section"
            );

          if (!section) {
            return;
          }

          const content =
            Array.from(
              section.children
            ).filter(
              (child) =>
                child !== heading
            );


          gsap.set(
            heading,
            {
              opacity: 0,
              y: 35,
              filter:
                "blur(3px)",
            }
          );


          if (content.length > 0) {
            gsap.set(
              content,
              {
                opacity: 0,
                y: 24,
              }
            );
          }


          ScrollTrigger.create({
            trigger: section,
            start: "top 78%",
            once: true,

            onEnter: () => {

              const sectionTimeline =
                gsap.timeline();

              sectionTimeline.to(
                heading,
                {
                  opacity: 1,
                  y: 0,
                  filter:
                    "blur(0px)",
                  duration: 1.0,
                  ease:
                    "power3.out",
                }
              );


              if (content.length > 0) {
                sectionTimeline.to(
                  content,
                  {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.06,
                    ease:
                      "power2.out",
                  },
                  "-=0.55"
                );
              }
            },
          });
        }
      );
    }


    /* ===================================================
       RELATED ITEMS
       =================================================== */

    const relatedItems =
      Array.from(
        document.querySelectorAll<HTMLElement>(
          "[data-related-item]"
        )
      );


    if (
      !reducedMotion &&
      relatedItems.length > 0
    ) {

      gsap.set(
        relatedItems,
        {
          opacity: 0,
          y: 18,
        }
      );


      ScrollTrigger.create({
        trigger:
          "[data-related-section]",

        start:
          "top 82%",

        once: true,

        onEnter: () => {

          gsap.to(
            relatedItems,
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              stagger: 0.06,
              ease:
                "power2.out",
            }
          );
        },
      });
    }


    /* ===================================================
       REFRESH
       =================================================== */

    requestAnimationFrame(
      () => {
        ScrollTrigger.refresh();
      }
    );


    window.addEventListener(
      "load",
      () => {
        ScrollTrigger.refresh();
      },
      {
        once: true,
      }
    );


    /* ===================================================
       ASTRO VIEW TRANSITIONS
       =================================================== */

    document.addEventListener(
      "astro:before-swap",
      () => {

        ScrollTrigger
          .getAll()
          .forEach(
            (trigger) => {
              trigger.kill();
            }
          );

      },
      {
        once: true,
      }
    );

  }
</script>