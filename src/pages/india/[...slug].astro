---
import {
  getCollection,
  render,
} from "astro:content";

import Layout from "../../layouts/Layout.astro";

import HistoricalMaterial
  from "../../components/history/HistoricalMaterial.astro";

import {
  resolveExperience,
} from "../../lib/experience/resolver";


/* =====================================================
   STATIC PATHS
   ===================================================== */

export async function getStaticPaths() {

  const entries =
    await getCollection(
      "historicalContent"
    );


  return entries.map(
    (entry) => ({

      params: {
        slug: entry.id,
      },

      props: {
        entry,
      },

    })
  );

}


/* =====================================================
   CONTENT
   ===================================================== */

const { entry } =
  Astro.props;


const { Content } =
  await render(entry);


const data =
  entry.data;


/* =====================================================
   AION EXPERIENCE
   ===================================================== */

/*
 * The visual experience is determined by:
 *
 * WORLD
 *   +
 * ERA
 *   +
 * CONTENT TYPE
 *
 * Example:
 *
 * india:classical-india:person
 *
 * or:
 *
 * india:modern-india:person
 *
 * Adding a new world/era/type only ever means adding
 * an entry to `combinations.ts` — everything below
 * (fonts, motion, pointer interaction) reads off the
 * profile's flat fields (material / typography /
 * titleMotion / interaction / atmosphere), so nothing
 * here needs to change.
 */

const experience =
  resolveExperience(
    data.world,
    data.era,
    data.type,
  );

---


<Layout
  title={`${data.title} — AION`}
  description={data.summary}
>

<main
  class="historical-entry"

  data-world-id={data.world}
  data-era-id={data.era}
  data-content-type={data.type}

  data-material={experience.material}
  data-texture={experience.texture}
  data-typography={experience.typography}
  data-title-motion={experience.titleMotion}
  data-interaction={experience.interaction}
  data-atmosphere={experience.atmosphere}
>

    <!-- =================================================
         HISTORICAL MATERIAL
         ================================================= -->

    <HistoricalMaterial
      worldId={data.world}
      eraId={data.era}
      contentType={data.type}
    />


    <!-- =================================================
         ARTICLE SHELL
         ================================================= -->

    <div
      class="historical-entry-shell"
    >


      <!-- =================================================
           HEADER
           ================================================= -->

      <header
        class="historical-entry-header"
        data-entry-header
      >


        <!-- BACK -->

        <a
          href="/india"
          class="historical-back"
          data-entry-element
        >

          <span
            class="back-mark"
          >
            ←
          </span>

          <span>
            INDIA
          </span>

        </a>


        <!-- META -->

        <div
          class="historical-entry-meta"
          data-entry-element
        >

          <span
            class="historical-type"
          >
            {data.type.toUpperCase()}
          </span>


          <span
            class="historical-status"
          >
            {data.status
              .replaceAll("-", " ")
              .toUpperCase()}
          </span>

        </div>


        <!-- =================================================
             TITLE
             ================================================= -->

        <div
          class="historical-title-wrap"
          data-entry-title-wrap
        >


          <!-- Physical/depth shadow -->

          <div
            class="historical-title-shadow"
            aria-hidden="true"
          >
            {data.title}
          </div>


          <!-- Actual title -->

          <h1
            data-entry-title
          >
            {data.title}
          </h1>


          <!-- Surface highlight -->

          <div
            class="historical-title-highlight"
            aria-hidden="true"
          >
            {data.title}
          </div>


          <!-- Moving material light -->

          <div
            class="historical-title-light"
            aria-hidden="true"
          ></div>


        </div>


        <!-- =================================================
             SUBTITLE
             ================================================= -->

        {
          data.subtitle && (

            <p
              class="historical-subtitle"
              data-entry-element
            >
              {data.subtitle}
            </p>

          )
        }


        <!-- =================================================
             SUMMARY
             ================================================= -->

        <p
          class="historical-summary"
          data-entry-element
        >
          {data.summary}
        </p>


        <!-- =================================================
             TAGS
             ================================================= -->

        {
          data.tags &&
          data.tags.length > 0 && (

            <div
              class="historical-tags"
              data-entry-tags
            >

              {
                data.tags.map(
                  (tag) => (

                    <span>
                      {tag}
                    </span>

                  )
                )
              }

            </div>

          )
        }


        <!-- =================================================
             HEADER RULE
             ================================================= -->

        <div
          class="historical-header-rule"
          aria-hidden="true"
        >

          <span></span>

        </div>


      </header>


      <!-- =================================================
           MARKDOWN CONTENT
           ================================================= -->

      <article
        class="historical-entry-body"
        data-historical-body
      >

        <Content />

      </article>


    </div>

  </main>

</Layout>


<style>


/* =========================================================
   AION HISTORICAL TYPOGRAPHY
   ========================================================= */

:global(:root) {

  --aion-font-ui:
    "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;


  /*
   * Monumental / inscriptional. Ancient (clay) and
   * Classical (stone) both read off this — ancient
   * content leans on it a little more loosely via
   * the "dust" title motion below.
   */

  --aion-font-inscription:
    "Cinzel Decorative",
    "Cinzel",
    Georgia,
    serif;


  /*
   * Old literary / manuscript character. Used for
   * medieval parchment and any classical/medieval
   * scroll (palm-leaf) content.
   */

  --aion-font-scripture:
    "IM FELL English",
    "IM FELL English SC",
    Georgia,
    "Times New Roman",
    serif;


  /*
   * Supporting historical display. Early modern
   * paper-era content.
   */

  --aion-font-display:
    "Cormorant Garamond",
    Georgia,
    "Times New Roman",
    serif;


  /*
   * Typewritten / bureaucratic character. Modern
   * archival documents (colonial & independence-era
   * records).
   */

  --aion-font-archival:
    "Special Elite",
    "Courier Prime",
    "Courier New",
    monospace;


  /*
   * Long-form reading.
   */

  --aion-font-reading:
    "Source Serif 4",
    Georgia,
    "Times New Roman",
    serif;

}


/* =========================================================
   PAGE
   ========================================================= */

.historical-entry {

  position:
    relative;

  min-height:
    100vh;

  overflow-x:
    hidden;

  isolation:
    isolate;

  background:
    transparent;

  color:
    #e8e3d8;

}


/* =========================================================
   ARTICLE SHELL
   ========================================================= */

.historical-entry-shell {

  position:
    relative;

  z-index:
    2;

  width:
    100%;

}


/* =========================================================
   HEADER
   ========================================================= */

.historical-entry-header {

  width:
    min(
      920px,
      calc(100% - 48px)
    );

  margin:
    0 auto;

  padding:
    110px 0 100px;

}


/* =========================================================
   BACK
   ========================================================= */

.historical-back {

  display:
    inline-flex;

  align-items:
    center;

  gap:
    10px;

  margin-bottom:
    58px;

  color:
    rgba(
      200,
      161,
      90,
      0.72
    );

  font-family:
    var(--aion-font-ui);

  font-size:
    10px;

  font-weight:
    600;

  letter-spacing:
    0.22em;

  text-decoration:
    none;

  transition:
    color 240ms ease;

}


.historical-back:hover {

  color:
    #e8e3d8;

}


.back-mark {

  font-size:
    15px;

  line-height:
    1;

  transition:
    transform 300ms ease;

}


.historical-back:hover
  .back-mark {

  transform:
    translateX(-5px);

}


/* =========================================================
   META
   ========================================================= */

.historical-entry-meta {

  display:
    flex;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    14px;

  margin-bottom:
    30px;

  font-family:
    var(--aion-font-ui);

}


.historical-type,
.historical-status {

  color:
    rgba(
      200,
      161,
      90,
      0.68
    );

  font-size:
    9px;

  font-weight:
    600;

  letter-spacing:
    0.19em;

}


.historical-status {

  color:
    rgba(
      232,
      227,
      216,
      0.38
    );

}


.historical-type::after {

  content:
    "·";

  margin-left:
    14px;

  color:
    rgba(
      200,
      161,
      90,
      0.30
    );

}


/* =========================================================
   TITLE WRAPPER
   ========================================================= */

.historical-title-wrap {

  position:
    relative;

  width:
    fit-content;

  max-width:
    100%;

  overflow:
    visible;

  transform-origin:
    center left;

  will-change:
    transform;

}


/* =========================================================
   MAIN TITLE
   default font is the inscription face; data-typography
   below overrides it per era.
   ========================================================= */

.historical-entry-header h1 {

  position:
    relative;

  z-index:
    3;

  max-width:
    900px;

  margin:
    0;

  color:
    #e8e3d8;

  font-family:
    var(--aion-font-inscription);

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight:
    400;

  line-height:
    0.90;

  letter-spacing:
    -0.025em;

  text-wrap:
    balance;

  will-change:
    transform,
    opacity,
    filter,
    letter-spacing;

}


/* =========================================================
   TITLE SHADOW
   ========================================================= */

.historical-title-shadow {

  position:
    absolute;

  z-index:
    1;

  inset:
    0;

  color:
    rgba(
      0,
      0,
      0,
      0.55
    );

  font-family:
    inherit;

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight:
    400;

  line-height:
    0.90;

  letter-spacing:
    -0.025em;

  transform:
    translate(
      0,
      3px
    );

  pointer-events:
    none;

}


/* =========================================================
   TITLE HIGHLIGHT
   ========================================================= */

.historical-title-highlight {

  position:
    absolute;

  z-index:
    4;

  inset:
    0;

  color:
    transparent;

  font-family:
    inherit;

  font-size:
    clamp(
      4rem,
      8vw,
      8rem
    );

  font-weight:
    400;

  line-height:
    0.90;

  letter-spacing:
    -0.025em;

  background:
    linear-gradient(
      180deg,
      rgba(
        255,
        255,
        255,
        0.16
      ),
      transparent 35%
    );

  background-clip:
    text;

  -webkit-background-clip:
    text;

  pointer-events:
    none;

  opacity:
    0.45;

}


/* =========================================================
   TITLE LIGHT
   ========================================================= */

.historical-title-light {

  position:
    absolute;

  z-index:
    5;

  top:
    -20%;

  left:
    -30%;

  width:
    35%;

  height:
    150%;

  opacity:
    0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(
        255,
        240,
        195,
        0.18
      ),
      transparent
    );

  transform:
    skewX(-18deg)
    translateX(-180%);

  pointer-events:
    none;

}


/* =========================================================================
   TYPOGRAPHY (data-typography)
   Controls the FONT for the title (and the two ghost
   layers, via `inherit`, above). Kept separate from
   title MOTION below, so a new era can mix and match
   e.g. "manuscript font + dust motion" freely.
   ========================================================================= */

.historical-entry[data-typography="inscription"]
  .historical-entry-header h1 {

  font-family:
    var(--aion-font-inscription);

  font-weight:
    400;

  letter-spacing:
    -0.025em;

}


.historical-entry[data-typography="manuscript"]
  .historical-entry-header h1 {

  font-family:
    var(--aion-font-scripture);

  font-weight:
    400;

  letter-spacing:
    -0.01em;

}


.historical-entry[data-typography="historical-display"]
  .historical-entry-header h1 {

  font-family:
    var(--aion-font-display);

  font-weight:
    500;

  letter-spacing:
    -0.035em;

}


.historical-entry[data-typography="archival"]
  .historical-entry-header h1 {

  font-family:
    var(--aion-font-archival);

  font-weight:
    400;

  font-size:
    clamp(
      2.6rem,
      6vw,
      5rem
    );

  letter-spacing:
    0.01em;

  text-transform:
    uppercase;

}


.historical-entry[data-typography="plain"]
  .historical-entry-header h1 {

  font-family:
    var(--aion-font-ui);

  font-weight:
    600;

  letter-spacing:
    -0.02em;

}


/* =========================================================================
   TITLE MOTION (data-title-motion)
   Purely the carved/inked/printed *feel* (shadow,
   ghost-layer opacity). The entrance animation itself
   lives in the script below, driven by the same
   attribute via TITLE_MOTION_CONFIG.
   ========================================================================= */

/* ENGRAVE — carved stone, hard highlight/shadow */

.historical-entry[data-title-motion="engrave"]
  .historical-entry-header h1 {

  text-shadow:

    0 1px 0
      rgba(
        255,
        255,
        255,
        0.08
      ),

    0 -1px 0
      rgba(
        0,
        0,
        0,
        0.55
      ),

    0 5px 18px
      rgba(
        0,
        0,
        0,
        0.55
      );

}


/* INK — softer bleed, no hard carve */

.historical-entry[data-title-motion="ink"]
  .historical-entry-header h1 {

  text-shadow:
    0 2px 8px
      rgba(
        20,
        12,
        4,
        0.45
      );

}

.historical-entry[data-title-motion="ink"]
  .historical-title-highlight {

  opacity:
    0.30;

  background:
    linear-gradient(
      180deg,
      rgba(
        255,
        244,
        214,
        0.10
      ),
      transparent 40%
    );

}


/* DUST — hazy, low-contrast, as if still half-buried */

.historical-entry[data-title-motion="dust"]
  .historical-entry-header h1 {

  text-shadow:
    0 3px 20px
      rgba(
        0,
        0,
        0,
        0.40
      );

}

.historical-entry[data-title-motion="dust"]
  .historical-title-highlight {

  opacity:
    0.22;

}


/* PRINT — crisp inked print onto archival paper */

.historical-entry[data-title-motion="print"]
  .historical-entry-header h1 {

  text-shadow:
    0 2px 12px
      rgba(
        0,
        0,
        0,
        0.38
      );

}

.historical-entry[data-title-motion="print"]
  .historical-title-highlight {

  opacity:
    0.18;

}


/* PLAIN — no flourish, fallback */

.historical-entry[data-title-motion="plain"]
  .historical-entry-header h1 {

  text-shadow:
    none;

}

.historical-entry[data-title-motion="plain"]
  .historical-title-shadow,
.historical-entry[data-title-motion="plain"]
  .historical-title-highlight,
.historical-entry[data-title-motion="plain"]
  .historical-title-light {

  display:
    none;

}


/* =========================================================
   SUBTITLE
   ========================================================= */

.historical-subtitle {

  max-width:
    680px;

  margin:
    32px 0 0;

  color:
    rgba(
      200,
      161,
      90,
      0.82
    );

  font-family:
    var(--aion-font-scripture);

  font-size:
    clamp(
      1.2rem,
      2vw,
      1.55rem
    );

  font-weight:
    400;

  font-style:
    italic;

  line-height:
    1.55;

}


/* =========================================================
   SUMMARY
   ========================================================= */

.historical-summary {

  max-width:
    680px;

  margin:
    34px 0 0;

  color:
    rgba(
      232,
      227,
      216,
      0.62
    );

  font-family:
    var(--aion-font-reading);

  font-size:
    17px;

  line-height:
    1.9;

}


/* =========================================================
   TAGS
   ========================================================= */

.historical-tags {

  display:
    flex;

  flex-wrap:
    wrap;

  gap:
    8px;

  margin-top:
    32px;

  font-family:
    var(--aion-font-ui);

}


.historical-tags span {

  padding:
    5px 9px;

  border:
    1px solid
    rgba(
      232,
      227,
      216,
      0.08
    );

  background:
    rgba(
      21,
      24,
      29,
      0.16
    );

  color:
    rgba(
      232,
      227,
      216,
      0.38
    );

  font-size:
    9px;

  letter-spacing:
    0.08em;

  text-transform:
    uppercase;

}


/* =========================================================
   HEADER RULE
   ========================================================= */

.historical-header-rule {

  width:
    100%;

  height:
    1px;

  margin-top:
    88px;

  overflow:
    hidden;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(
        200,
        161,
        90,
        0.10
      ),
      transparent
    );

}


.historical-header-rule span {

  display:
    block;

  width:
    30%;

  height:
    1px;

  background:
    rgba(
      200,
      161,
      90,
      0.42
    );

  transform:
    scaleX(0);

  transform-origin:
    left center;

}


/* =========================================================
   MARKDOWN BODY
   ========================================================= */

.historical-entry-body {

  width:
    min(
      760px,
      calc(100% - 48px)
    );

  margin:
    0 auto;

  padding:
    10px 0 220px;

  color:
    rgba(
      232,
      227,
      216,
      0.78
    );

  font-family:
    var(--aion-font-reading);

  font-size:
    19px;

  line-height:
    2;

}


/* =========================================================================
   MARKDOWN BODY TYPOGRAPHY OVERRIDES
   The body copy stays on the reading serif for
   legibility across every era, but headings inside
   the markdown pick up the same typography choice as
   the page title so the whole article feels of one era.
   ========================================================================= */

.historical-entry[data-typography="manuscript"]
  .historical-entry-body
  :global(h2),
.historical-entry[data-typography="manuscript"]
  .historical-entry-body
  :global(h3) {

  font-family:
    var(--aion-font-scripture);

}


.historical-entry[data-typography="historical-display"]
  .historical-entry-body
  :global(h2),
.historical-entry[data-typography="historical-display"]
  .historical-entry-body
  :global(h3) {

  font-family:
    var(--aion-font-display);

}


.historical-entry[data-typography="archival"]
  .historical-entry-body
  :global(h2) {

  font-family:
    var(--aion-font-archival);

  text-transform:
    uppercase;

  letter-spacing:
    0.02em;

}


.historical-entry[data-typography="plain"]
  .historical-entry-body
  :global(h2),
.historical-entry[data-typography="plain"]
  .historical-entry-body
  :global(h3) {

  font-family:
    var(--aion-font-ui);

}


/* =========================================================
   HISTORICAL SECTION
   ========================================================= */

.historical-entry-body
  :global(.historical-section) {

  position:
    relative;

  margin:
    150px 0;

  will-change:
    transform,
    opacity;

}


/* =========================================================
   SECTION HEADING
   ========================================================= */

.historical-entry-body
  :global(h2) {

  position:
    relative;

  margin:
    0 0 36px;

  color:
    #e8e3d8;

  font-family:
    var(--aion-font-scripture);

  font-size:
    clamp(
      2.25rem,
      4vw,
      3.5rem
    );

  font-weight:
    400;

  line-height:
    1.08;

  letter-spacing:
    -0.015em;

  scroll-margin-top:
    120px;

  will-change:
    transform,
    opacity,
    filter,
    clip-path;

}


/* =========================================================
   SECTION DIVIDER
   ========================================================= */

.historical-entry-body
  :global(h2::after) {

  content:
    "";

  display:
    block;

  width:
    70px;

  height:
    1px;

  margin-top:
    22px;

  background:
    rgba(
      200,
      161,
      90,
      0.42
    );

  transform:
    scaleX(1);

  transform-origin:
    left center;

}


/* =========================================================
   H3
   ========================================================= */

.historical-entry-body
  :global(h3) {

  margin:
    72px 0 22px;

  color:
    rgba(
      232,
      227,
      216,
      0.88
    );

  font-family:
    var(--aion-font-scripture);

  font-size:
    1.7rem;

  font-weight:
    400;

  line-height:
    1.3;

}


/* =========================================================
   PARAGRAPHS
   ========================================================= */

.historical-entry-body
  :global(p) {

  max-width:
    760px;

  margin:
    0 0 30px;

}


/* =========================================================
   FIRST LETTER
   ========================================================= */

.historical-entry-body
  :global(
    .historical-section > p:first-of-type::first-letter
  ) {

  float:
    left;

  margin:
    8px 10px 0 0;

  color:
    #c8a15a;

  font-family:
    var(--aion-font-inscription);

  font-size:
    3.4em;

  line-height:
    0.78;

}


/* =========================================================
   STRONG
   ========================================================= */

.historical-entry-body
  :global(strong) {

  color:
    #e8e3d8;

  font-weight:
    600;

}


/* =========================================================
   EMPHASIS
   ========================================================= */

.historical-entry-body
  :global(em) {

  color:
    rgba(
      232,
      227,
      216,
      0.86
    );

  font-family:
    var(--aion-font-scripture);

}


/* =========================================================
   LISTS
   ========================================================= */

.historical-entry-body
  :global(ul),
.historical-entry-body
  :global(ol) {

  max-width:
    760px;

  margin:
    34px 0;

  padding-left:
    30px;

}


.historical-entry-body
  :global(li) {

  margin:
    11px 0;

}


/* =========================================================
   LINKS
   ========================================================= */

