     a new motion to the type only ever means adding a
     row here — the intro timeline below just reads
     off whichever config matches `data-title-motion`.
     ===================================================== */

  const TITLE_MOTION_CONFIG: Record<
    string,
    {
      initialY: number;
      initialBlur: number;
      initialLetterSpacing: string;
      finalLetterSpacing: string;
      duration: number;
      ease: string;
      shadowInitialY: number;
      shadowFinalOpacity: number;
      highlightInitialY: number;
      highlightFinalOpacity: number;
      showLight: boolean;
    }
  > = {

    engrave: {
      initialY: 55,
      initialBlur: 4,
      initialLetterSpacing: "0.035em",
      finalLetterSpacing: "-0.025em",
      duration: 1.55,
      ease: "power3.out",
      shadowInitialY: 61,
      shadowFinalOpacity: 0.52,
      highlightInitialY: 50,
      highlightFinalOpacity: 0.45,
      showLight: false,
    },

    ink: {
      initialY: 26,
      initialBlur: 3,
      initialLetterSpacing: "0.01em",
      finalLetterSpacing: "-0.01em",
      duration: 1.3,
      ease: "power2.out",
      shadowInitialY: 30,
      shadowFinalOpacity: 0.34,
      highlightInitialY: 22,
      highlightFinalOpacity: 0.30,
      showLight: false,
    },

    dust: {
      initialY: 16,
      initialBlur: 6,
      initialLetterSpacing: "0.02em",
      finalLetterSpacing: "0em",
      duration: 1.8,
      ease: "power1.out",
      shadowInitialY: 18,
      shadowFinalOpacity: 0.28,
      highlightInitialY: 14,
      highlightFinalOpacity: 0.22,
      showLight: false,
    },

    print: {
      initialY: 18,
      initialBlur: 1.5,
      initialLetterSpacing: "0.015em",
      finalLetterSpacing: "-0.035em",
      duration: 1.0,
      ease: "power2.out",
      shadowInitialY: 21,
      shadowFinalOpacity: 0.30,
      highlightInitialY: 16,
      highlightFinalOpacity: 0.18,
      showLight: true,
    },

    plain: {
      initialY: 10,
      initialBlur: 0,
      initialLetterSpacing: "0em",
      finalLetterSpacing: "0em",
      duration: 0.6,
      ease: "power1.out",
      shadowInitialY: 0,
      shadowFinalOpacity: 0,
      highlightInitialY: 0,
      highlightFinalOpacity: 0,
      showLight: false,
    },

  };


  /* =====================================================
     INTERACTION CONFIG
     =====================================================

     One entry per HistoricalInteraction value. Controls
     both the pointer-tilt "relief" loop and the anime.js
     hover micro-interaction.
     ===================================================== */

  const INTERACTION_CONFIG: Record<
    string,
    {
      tiltX: number;
      tiltY: number;
      hoverScale: number;
      highlightHoverOpacity: number;
    }
  > = {

    relief: {
      tiltX: 4,
      tiltY: 2.5,
      hoverScale: 1.008,
      highlightHoverOpacity: 0.62,
    },

    ink: {
      tiltX: 1.6,
      tiltY: 1,
      hoverScale: 1.004,
      highlightHoverOpacity: 0.42,
    },

    paper: {
      tiltX: 0.6,
      tiltY: 0.4,
      hoverScale: 1.002,
      highlightHoverOpacity: 0.28,
    },

    none: {
      tiltX: 0,
      tiltY: 0,
      hoverScale: 1,
      highlightHoverOpacity: 0,
    },

  };


  /* =====================================================
     AION HISTORICAL ARTICLE ENGINE
     ===================================================== */

  const entry =
    document.querySelector<HTMLElement>(
      ".historical-entry"
    );


  const header =
    document.querySelector<HTMLElement>(
      "[data-entry-header]"
    );


  const body =
    document.querySelector<HTMLElement>(
      "[data-historical-body]"
    );


  /*
   * Stop safely if this isn't
   * an historical article page.
   */

  if (
    entry &&
    header &&
    body
  ) {


    /* ===================================================
       MOTION PREFERENCE
       =================================================== */

    const reducedMotion =
      window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;


    /* ===================================================
       EXPERIENCE
       =================================================== */

    const titleMotion =
      entry.dataset.titleMotion ??
      "plain";


    const motion =
      TITLE_MOTION_CONFIG[titleMotion] ??
      TITLE_MOTION_CONFIG.plain;


    const interaction =
      entry.dataset.interaction ??
      "none";


    const pointer =
      INTERACTION_CONFIG[interaction] ??
      INTERACTION_CONFIG.none;


    /* ===================================================
       ELEMENTS
       =================================================== */

    const title =
      header.querySelector<HTMLElement>(
        "[data-entry-title]"
      );


    const titleShadow =
      header.querySelector<HTMLElement>(
        ".historical-title-shadow"
      );


    const titleHighlight =
      header.querySelector<HTMLElement>(
        ".historical-title-highlight"
      );


    const titleLight =
      header.querySelector<HTMLElement>(
        ".historical-title-light"
      );


    const titleWrap =
      header.querySelector<HTMLElement>(
        "[data-entry-title-wrap]"
      );


    const headerElements =
      Array.from(
        header.querySelectorAll<HTMLElement>(
          "[data-entry-element]"
        )
      );


    const headerRule =
      header.querySelector<HTMLElement>(
        ".historical-header-rule span"
      );


    /* ===================================================
       OPENING ANIMATION
       =================================================== */

    if (!reducedMotion) {


      /* -------------------------------------------------
         Supporting elements
         ------------------------------------------------- */

      gsap.set(
        headerElements,
        {
          opacity: 0,
          y: 18,
        }
      );


      /* -------------------------------------------------
         Main title — initial state comes straight
         from TITLE_MOTION_CONFIG.
         ------------------------------------------------- */

      if (title) {

        gsap.set(
          title,
          {
            opacity: 0,
            y: motion.initialY,
            filter:
              `blur(${motion.initialBlur}px)`,
            letterSpacing:
              motion.initialLetterSpacing,
          }
        );

      }


      /* -------------------------------------------------
         Shadow
         ------------------------------------------------- */

      if (titleShadow) {

        gsap.set(
          titleShadow,
          {
            opacity: 0,
            y: motion.shadowInitialY,
          }
        );

      }


      /* -------------------------------------------------
         Highlight
         ------------------------------------------------- */

      if (titleHighlight) {

        gsap.set(
          titleHighlight,
          {
            opacity: 0,
            y: motion.highlightInitialY,
          }
        );

      }


      /* -------------------------------------------------
         Title light
         ------------------------------------------------- */

      if (titleLight) {

        gsap.set(
          titleLight,
          {
            opacity: 0,
          }
        );

      }


      /* -------------------------------------------------
         Header divider
         ------------------------------------------------- */

      if (headerRule) {

        gsap.set(
          headerRule,
          {
            scaleX: 0,
            transformOrigin:
              "left center",
          }
        );

      }


      /* =================================================
         INTRO TIMELINE
         ================================================= */

      const intro =
        gsap.timeline({

          defaults: {
            ease:
              "power3.out",
          },

        });


      /* -------------------------------------------------
         Metadata
         ------------------------------------------------- */

      intro.to(
        headerElements,
        {
          opacity: 1,
          y: 0,
          duration: 0.75,
          stagger: 0.07,
        }
      );


      /* -------------------------------------------------
         Shadow
         ------------------------------------------------- */

      if (titleShadow) {

        intro.to(
          titleShadow,
          {
            opacity:
              motion.shadowFinalOpacity,

            y: 0,

            duration:
              motion.duration,

            ease:
              "power3.out",

          },
          "-=0.35"
        );

      }


      /* -------------------------------------------------
         Main title
         ------------------------------------------------- */

      if (title) {

        intro.to(
          title,
          {

            opacity: 1,

            y: 0,

            filter:
              "blur(0px)",

            letterSpacing:
              motion.finalLetterSpacing,

            duration:
              motion.duration,

            ease:
              motion.ease,

          },

          `-=${Math.min(motion.duration * 0.7, 1.05)}`

        );

      }


      /* -------------------------------------------------
         Highlight
         ------------------------------------------------- */

      if (titleHighlight) {

        intro.to(
          titleHighlight,
          {

            opacity:
              motion.highlightFinalOpacity,

            y: 0,

            duration:
              motion.duration * 0.75,

            ease:
              "power2.out",

          },

          "-=0.9"
        );

      }


      /* -------------------------------------------------
         Archival print light sweep
         (only for motions that opt in via `showLight`)
         ------------------------------------------------- */

      if (
        titleLight &&
        motion.showLight
      ) {

        intro.to(
          titleLight,
          {
            opacity: 0.7,
            duration: 0.25,
          },
          "-=0.25"
        );


        intro.to(
          titleLight,
          {
            xPercent: 600,
            opacity: 0,
            duration: 1.1,
            ease:
              "power2.inOut",
          }
        );

      }


      /* -------------------------------------------------
         Supporting information
         ------------------------------------------------- */

      const supporting =
        header.querySelectorAll(
          ".historical-subtitle, .historical-summary, .historical-tags"
        );


      if (
        supporting.length > 0
      ) {

        intro.to(
          supporting,
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.08,
          },
          "-=0.65"
        );

      }


      /* -------------------------------------------------
         Divider
         ------------------------------------------------- */

      if (headerRule) {

        intro.to(
          headerRule,
          {
            scaleX: 1,
            duration: 1.15,
            ease:
              "power2.out",
          },
          "-=0.55"
        );

      }

    }


    /* ===================================================
       TITLE POINTER INTERACTION
       Driven by `data-interaction` — "none" disables
       this loop entirely (also respects reduced motion).
       =================================================== */

    if (
      titleWrap &&
      title &&
      !reducedMotion &&
      (pointer.tiltX > 0 || pointer.tiltY > 0)
    ) {


      let targetX = 0;

      let targetY = 0;

      let currentX = 0;

      let currentY = 0;


      titleWrap.addEventListener(
        "pointermove",
        (event) => {

          const rect =
            titleWrap.getBoundingClientRect();


          const x =
            (
              event.clientX -
              rect.left
            ) /
            rect.width;


          const y =
            (
              event.clientY -
              rect.top
            ) /
            rect.height;


          targetX =
            (x - 0.5) * pointer.tiltX;


          targetY =
            (y - 0.5) * pointer.tiltY;

        }
      );


      titleWrap.addEventListener(
        "pointerleave",
        () => {

          targetX = 0;

          targetY = 0;

        }
      );


      const updateRelief =
        () => {

          currentX +=
            (
              targetX -
              currentX
            ) * 0.08;


          currentY +=
            (
              targetY -
              currentY
            ) * 0.08;


          gsap.set(
            title,
            {
              x:
                currentX,

              y:
                currentY,
            }
          );


          if (
            titleHighlight
          ) {

            gsap.set(
              titleHighlight,
              {
                x:
                  currentX *
                  0.35,

                y:
                  currentY *
                  0.35,
              }
            );

          }


          if (
            titleShadow
          ) {

            gsap.set(
              titleShadow,
              {
                x:
                  currentX *
                  -0.18,

                y:
                  currentY *
                  -0.18,
              }
            );

          }


          requestAnimationFrame(
            updateRelief
          );

        };


      updateRelief();

    }


    /* ===================================================
       ANIME.JS MICRO INTERACTION
       Skipped entirely for interaction "none".
       =================================================== */

    if (
      titleWrap &&
      !reducedMotion &&
      interaction !== "none"
    ) {


      titleWrap.addEventListener(
        "pointerenter",
        () => {

          try {

            animeAnimate(
              titleWrap,
              {
                scale:
                  pointer.hoverScale,

                duration:
                  500,

                ease:
                  "out(3)",
              }
            );


            if (
              titleHighlight
            ) {

              animeAnimate(
                titleHighlight,
                {

                  opacity:
                    pointer.highlightHoverOpacity,

                  duration:
                    500,

                  ease:
                    "out(3)",

                }
              );

            }

          }
          catch (
            error
          ) {

            /*
             * Anime.js is only a
             * micro-interaction layer.
             *
             * Never allow it to
             * break GSAP.
             */

            console.warn(
              "AION: Anime.js interaction failed.",
              error
            );

          }

        }
      );


      titleWrap.addEventListener(
        "pointerleave",
        () => {

          try {

            animeAnimate(
              titleWrap,
              {
                scale: 1,
                duration:
                  700,
                ease:
                  "out(3)",
              }
            );


            if (
              titleHighlight
            ) {

              animeAnimate(
                titleHighlight,
                {

                  opacity:
                    motion.highlightFinalOpacity,

                  duration:
                    700,

                  ease:
                    "out(3)",

                }
              );

            }

          }
          catch (
            error
          ) {

            console.warn(
              "AION: Anime.js interaction failed.",
              error
            );

          }

        }
      );

    }


    /* ===================================================
       MARKDOWN HEADINGS
       =================================================== */

    const headings =
      Array.from(
        body.querySelectorAll<HTMLElement>(
          ":scope > h2"
        )
      );


    /* ===================================================
       SECTION CREATION
       =================================================== */

    if (
      headings.length > 0
    ) {


      headings.forEach(
        (heading) => {

          const section =
            document.createElement(
              "section"
            );


          section.className =
            "historical-section";


          section.dataset.sectionState =
            "future";


          body.insertBefore(
            section,
            heading
          );


          section.appendChild(
            heading
          );


          let next =
            section.nextElementSibling;


          while (
            next &&
            next.tagName !== "H2"
          ) {

            const current =
              next;


            next =
              next.nextElementSibling;


            section.appendChild(
              current
            );

          }

        }
      );


      /* =================================================
         SECTIONS
         ================================================= */

      const sections =
        Array.from(
          body.querySelectorAll<HTMLElement>(
            ".historical-section"
          )
        );


      /* =================================================
         INITIAL SECTION STATE
         ================================================= */

      sections.forEach(
        (section) => {

          const heading =
            section.querySelector<HTMLElement>(
              "h2"
            );


          const content =
            Array.from(
              section.children
            ).filter(
              (element) =>
                element !== heading
            ) as HTMLElement[];


          if (
            reducedMotion
          ) {

            gsap.set(
              section,
              {
                opacity: 1,
                y: 0,
              }
            );


            if (
              heading
            ) {

              gsap.set(
                heading,
                {
                  opacity: 1,
                  y: 0,
                  filter:
                    "none",
                  clipPath:
                    "inset(0 0% 0 0)",
                }
              );

            }


            gsap.set(
              content,
              {
                opacity: 1,
                y: 0,
              }
            );


            return;

          }


          /*
           * Everything starts slightly
           * below and faded.
           */

          gsap.set(
            section,
            {
              opacity: 0.42,
              y: 38,
            }
          );


          if (
            heading
          ) {

            gsap.set(
              heading,
              {
                opacity: 0.32,
                y: 24,
                filter:
                  "blur(1.5px)",
                clipPath:
                  "inset(0 100% 0 0)",
              }
            );

          }


          gsap.set(
            content,
            {
              opacity: 0.22,
              y: 16,
            }
          );

        }
      );


      /* =================================================
         SCROLL EXPERIENCE
         ================================================= */

      if (
        !reducedMotion
      ) {


        sections.forEach(
          (section) => {

            const heading =
              section.querySelector<HTMLElement>(
                "h2"
              );


            const content =
              Array.from(
                section.children
              ).filter(
                (element) =>
                  element !== heading
              ) as HTMLElement[];


            /*
             * One timeline controls the
             * ENTIRE life of the section.
             *
             * This avoids multiple
             * ScrollTriggers fighting
             * over the same properties.
             */

            const timeline =
              gsap.timeline({

                scrollTrigger: {

                  trigger:
                    section,

                  start:
                    "top 86%",

                  end:
                    "bottom 18%",

                  scrub:
                    1,

                  invalidateOnRefresh:
                    true,

                },

              });


            /* ---------------------------------------------
               FUTURE → PRESENT
               --------------------------------------------- */

            timeline.to(
              section,
              {

                opacity: 1,

                y: 0,

                duration:
                  0.28,

                ease:
                  "none",

              }
            );


            if (
              heading
            ) {

              timeline.to(
                heading,
                {

                  opacity: 1,

                  y: 0,

                  filter:
                    "blur(0px)",

                  clipPath:
                    "inset(0 0% 0 0)",

                  duration:
                    0.28,

                  ease:
                    "none",

                },

                "<"

              );

            }


            timeline.to(
              content,
              {

                opacity: 1,

                y: 0,

                duration:
                  0.28,

                ease:
                  "none",

              },

              "<0.04"

            );


            /* ---------------------------------------------
               PRESENT
               --------------------------------------------- */

            timeline.to(
              section,
              {

                opacity: 1,

                y: 0,

                duration:
                  0.34,

                ease:
                  "none",

              }
            );


            /* ---------------------------------------------
               PRESENT → PAST
               --------------------------------------------- */

            timeline.to(
              section,
              {

                opacity:
                  0.56,

                y:
                  -32,

                duration:
                  0.38,

                ease:
                  "none",

              }
            );


            if (
              heading
            ) {

              timeline.to(
                heading,
                {

                  opacity:
                    0.58,

                  y:
                    -24,

                  filter:
                    "blur(0.5px)",

                  duration:
                    0.38,

                  ease:
                    "none",

                },

                "<"

              );

            }


            timeline.to(
              content,
              {

                opacity:
                  0.52,

                y:
                  -14,

                duration:
                  0.38,

                ease:
                  "none",

              },

              "<"

            );


            /*
             * Section state is used only
             * as semantic information.
             */

            ScrollTrigger.create({

              trigger:
                section,

              start:
                "top 60%",

              end:
                "bottom 40%",

              onEnter:
                () => {

                  section.dataset.sectionState =
                    "current";

                },

              onEnterBack:
                () => {

                  section.dataset.sectionState =
                    "current";

                },

              onLeave:
                () => {

                  section.dataset.sectionState =
                    "past";

                },

              onLeaveBack:
                () => {

                  section.dataset.sectionState =
                    "future";

                },

            });

          }
        );

      }


      /* =================================================
         REFRESH
         ================================================= */

      requestAnimationFrame(
        () => {

          ScrollTrigger.refresh();

        }
      );


      window.addEventListener(
        "load",
        () => {

          ScrollTrigger.refresh();

        },
        {
          once: true,
        }
      );


      /* =================================================
         ASTRO VIEW TRANSITIONS
         ================================================= */

      document.addEventListener(
        "astro:before-swap",
        () => {

          ScrollTrigger
            .getAll()
            .forEach(
              (trigger) => {

                trigger.kill();

              }
            );

        },
        {
          once: true,
        }
      );

    }

  }

</script>