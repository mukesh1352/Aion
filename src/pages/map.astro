---
import Layout from "../layouts/Layout.astro";

import "../styles/map.css";
---

<Layout
  title="AION — Historical World"
  description="Explore humanity through time."
>

  <main class="map-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="map-header">

      <a
        href="/"
        class="map-logo"
        aria-label="AION Home"
      >
        AION
      </a>


      <div class="map-header-center">

        <span class="eyebrow">
          THE HISTORIC WORLD
        </span>

        <span class="header-period">
          GLOBAL
        </span>

      </div>


      <nav
        class="map-navigation"
        aria-label="Primary navigation"
      >

        <a
          href="/map"
          class="active"
        >
          MAP
        </a>

        <a href="/timeline">
          TIMELINE
        </a>

        <a href="/library">
          LIBRARY
        </a>

        <a href="/about">
          ABOUT
        </a>

      </nav>

    </header>


    <!-- =====================================================
         MAP
    ====================================================== -->

    <div
      id="world-map"
      class="world-map"
      aria-label="Interactive historical world map"
    ></div>


    <!-- =====================================================
         VIGNETTE
    ====================================================== -->

    <div
      class="map-vignette"
      aria-hidden="true"
    ></div>


    <!-- =====================================================
         STATUS
    ====================================================== -->

    <div
      class="map-status"
      aria-live="polite"
    >

      <span class="status-dot"></span>

      <span id="map-status-text">
        EXPLORING THE WORLD
      </span>

    </div>


    <!-- =====================================================
         WORLD PANEL
    ====================================================== -->

    <aside
      id="world-panel"
      class="world-panel"
      aria-hidden="true"
    >

      <button
        id="close-world"
        class="close-world"
        type="button"
        aria-label="Close world information"
      >
        ×
      </button>


      <span class="world-panel-eyebrow">
        HISTORIC WORLD
      </span>


      <h1 id="world-name"></h1>


      <p id="world-description"></p>


      <a
        id="world-enter"
        class="world-enter"
        href="#"
      >

        <span id="world-enter-label">
          ENTER WORLD
        </span>

        <span aria-hidden="true">
          →
        </span>

      </a>

    </aside>


    <!-- =====================================================
         INSTRUCTIONS
    ====================================================== -->

    <div
      class="map-instruction"
      aria-hidden="true"
    >

      DRAG TO EXPLORE

      <span>/</span>

      SCROLL TO ZOOM

      <span>/</span>

      SELECT A WORLD

    </div>

  </main>
</Layout>


<script>

  import {
    historicalWorlds,
    type HistoricalWorld,
  } from "../lib/worlds";

  import {
    createAionMap,
    hideMapLabels,
  } from "../lib/map/map";

  import {
    addWorldMarker,
  } from "../lib/map/markers";


  /*
   * =========================================================
   * DOM
   * =========================================================
   */

  const mapElement =
    document.getElementById(
      "world-map"
    );

  const worldPanel =
    document.getElementById(
      "world-panel"
    );

  const closeWorld =
    document.getElementById(
      "close-world"
    );

  const worldName =
    document.getElementById(
      "world-name"
    );

  const worldDescription =
    document.getElementById(
      "world-description"
    );

  const worldEnter =
    document.getElementById(
      "world-enter"
    );

  const worldEnterLabel =
    document.getElementById(
      "world-enter-label"
    );

  const mapStatus =
    document.getElementById(
      "map-status-text"
    );


  /*
   * =========================================================
   * DOM VALIDATION
   * =========================================================
   */

  if (
    !(mapElement instanceof HTMLDivElement) ||
    !(worldPanel instanceof HTMLElement) ||
    !(closeWorld instanceof HTMLButtonElement) ||
    !(worldName instanceof HTMLElement) ||
    !(worldDescription instanceof HTMLElement) ||
    !(worldEnter instanceof HTMLAnchorElement) ||
    !(worldEnterLabel instanceof HTMLElement) ||
    !(mapStatus instanceof HTMLElement)
  ) {

    throw new Error(
      "AION map: required DOM elements are missing."
    );

  }


  /*
   * =========================================================
   * STATE
   * =========================================================
   */

  let selectedWorld:
    HistoricalWorld | null =
    null;


  /*
   * =========================================================
   * OPEN WORLD
   * =========================================================
   */

  function openWorld(
    world: HistoricalWorld
  ): void {

    selectedWorld =
      world;


    worldName.textContent =
      world.name;


    worldDescription.textContent =
      world.description;


    worldEnter.href =
      world.path;


    worldEnterLabel.textContent =
      `ENTER ${world.name.toUpperCase()}`;


    worldPanel.classList.add(
      "visible"
    );


    worldPanel.setAttribute(
      "aria-hidden",
      "false"
    );


    mapStatus.textContent =
      `${world.name.toUpperCase()} SELECTED`;

  }


  /*
   * =========================================================
   * CLOSE WORLD
   * =========================================================
   */

  function closeWorldPanel(): void {

    selectedWorld =
      null;


    worldPanel.classList.remove(
      "visible"
    );


    worldPanel.setAttribute(
      "aria-hidden",
      "true"
    );


    mapStatus.textContent =
      "EXPLORING THE WORLD";

  }


  /*
   * =========================================================
   * CLOSE BUTTON
   * =========================================================
   */

  closeWorld.addEventListener(
    "click",
    closeWorldPanel
  );


  /*
   * =========================================================
   * MAP
   * =========================================================
   */

  const map =
    createAionMap(
      mapElement
    );


  /*
   * =========================================================
   * MAP READY
   * =========================================================
   */

  map.once(
    "load",
    () => {

      hideMapLabels(
        map
      );


      for (
        const world of historicalWorlds
      ) {

        addWorldMarker(
          map,
          world,
          openWorld
        );

      }

    }
  );


  /*
   * =========================================================
   * ENTER WORLD
   * =========================================================
   */

  worldEnter.addEventListener(
    "click",
    (event) => {

      event.preventDefault();


      if (!selectedWorld) {
        return;
      }


      window.location.href =
        selectedWorld.path;

    }
  );


  /*
   * =========================================================
   * ESCAPE
   * =========================================================
   */

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "Escape"
      ) {

        closeWorldPanel();

      }

    }
  );

</script>