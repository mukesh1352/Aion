---
import Layout from "../layouts/Layout.astro";
import HistoricalTimeline from "../components/timeline/HistoricalTimeline.astro";
import IndiaAtmosphere from "../components/history/IndiaAtmosphere.astro";
import IndiaHistoryContent from "../components/history/IndiaHistoryContent.astro";
---

<Layout
  title="India — AION"
  description="Explore India through time."
>
  <main class="india-page">

    <!-- ==================================================
         INDIA ATMOSPHERE
         ================================================== -->

    <IndiaAtmosphere />


    <!-- ==================================================
         HEADER
         ================================================== -->

    <header class="india-header">

      <!-- World navigation -->

      <a
        href="/map"
        class="india-header-world"
        aria-label="Return to world map"
      >
        <span class="india-header-arrow">
          ←
        </span>

        <span class="india-header-world-text">
          WORLD MAP
        </span>
      </a>


      <!-- AION -->

      <a
        href="/"
        class="india-header-logo"
        aria-label="AION home"
      >
        AION
      </a>


      <!-- Current world -->

      <div class="india-header-location">

        <span
          class="india-header-location-line"
        ></span>

        <span
          class="india-header-location-text"
        >
          INDIA
        </span>

      </div>

    </header>


    <!-- ==================================================
         HISTORY TIMELINE
         ================================================== -->

    <HistoricalTimeline
      worldId="india"
    />


    <!-- ==================================================
         HISTORICAL CONTENT
         ================================================== -->

    <IndiaHistoryContent
      worldId="india"
    />

  </main>
</Layout>


<style>

/* ==================================================
   PAGE
   ================================================== */

.india-page {
  position: relative;

  min-height: 100vh;

  overflow-x: hidden;

  background: transparent;

  color: #e8e3d8;

  isolation: isolate;
}


/*
 * Everything except the atmosphere sits above
 * the Three.js/CSS background.
 */

.india-page > *:not(.india-atmosphere) {
  position: relative;

  z-index: 2;
}


/* ==================================================
   HEADER
   ================================================== */

.india-header {
  position: relative;

  z-index: 100;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  width: 100%;

  height: 72px;

  padding:
    0
    clamp(2rem, 5vw, 5rem);

  box-sizing: border-box;

  background:
    linear-gradient(
      to bottom,
      rgba(8, 10, 13, 0.94),
      rgba(8, 10, 13, 0.76)
    );

  border-bottom:
    1px solid
    rgba(200, 161, 90, 0.14);

  backdrop-filter:
    blur(10px);

  -webkit-backdrop-filter:
    blur(10px);
}


/* ==================================================
   WORLD MAP
   ================================================== */

.india-header-world {
  justify-self: start;

  display: inline-flex;

  align-items: center;

  gap: 0.65rem;

  width: fit-content;

  color:
    rgba(
      232,
      227,
      216,
      0.58
    );

  font-size: 0.65rem;

  font-weight: 500;

  letter-spacing: 0.2em;

  text-decoration: none;

  transition:
    color 220ms ease,
    transform 220ms ease;
}


.india-header-world:hover {
  color: #e8e3d8;

  transform:
    translateX(-3px);
}


.india-header-arrow {
  display: inline-block;

  color: #c8a15a;

  font-size: 1rem;

  line-height: 1;

  transition:
    transform 220ms ease;
}


.india-header-world:hover
.india-header-arrow {
  transform:
    translateX(-3px);
}


.india-header-world-text {
  line-height: 1;
}


/* ==================================================
   AION LOGO
   ================================================== */

.india-header-logo {
  justify-self: center;

  color: #e8e3d8;

  font-size: 0.8rem;

  font-weight: 500;

  letter-spacing: 0.42em;

  text-decoration: none;

  transform:
    translateX(0.21em);

  transition:
    color 220ms ease;
}


.india-header-logo:hover {
  color: #c8a15a;
}


/* ==================================================
   CURRENT LOCATION
   ================================================== */

.india-header-location {
  justify-self: end;

  display: flex;

  align-items: center;

  gap: 0.7rem;
}


.india-header-location-line {
  display: block;

  width: 28px;

  height: 1px;

  background:
    rgba(
      200,
      161,
      90,
      0.45
    );
}


.india-header-location-text {
  color: #c8a15a;

  font-size: 0.65rem;

  font-weight: 500;

  letter-spacing: 0.24em;
}


/* ==================================================
   MOBILE
   ================================================== */

@media (max-width: 700px) {

  .india-header {
    height: 64px;

    padding:
      0 1.25rem;
  }


  .india-header-world-text {
    display: none;
  }


  .india-header-arrow {
    font-size: 1.2rem;
  }


  .india-header-logo {
    font-size: 0.72rem;

    letter-spacing: 0.3em;
  }


  .india-header-location-line {
    display: none;
  }


  .india-header-location-text {
    font-size: 0.58rem;
  }

}

</style>